{
  "extends": "./tsconfig.json",
  "include": [
    "server/**/*.ts",
    "ecosystem/plugin-kit/**/*.ts",
    "ecosystem/plugins/reference/**/*.ts",
    "src/lib/plugin-contract.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
