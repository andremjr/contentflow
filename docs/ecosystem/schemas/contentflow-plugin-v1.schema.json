{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v1.schema.json",
  "title": "ContentFlow Plugin Manifest API v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "runtime",
    "entrypoint",
    "permissions",
    "capabilities"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "apiVersion": { "const": "1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "minLength": 3,
      "maxLength": 160
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "author": { "type": "string", "minLength": 1, "maxLength": 160 },
    "license": { "type": "string", "minLength": 1, "maxLength": 160 },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iconPath"],
      "properties": {
        "iconPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:png|webp)$"
        }
      }
    },
    "localizations": {
      "type": "object",
      "description": "Mapa opcional de traduções de textos visíveis do plugin por locale BCP 47. IDs, valores técnicos e conteúdo do usuário não são traduzidos.",
      "propertyNames": {
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
      },
      "additionalProperties": { "$ref": "#/$defs/manifestLocalization" }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "module"],
      "properties": {
        "kind": { "const": "node" },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "module": { "const": "esm" }
      }
    },
    "minCoreVersion": { "$ref": "#/$defs/semver" },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "supportsConversationContinuation": { "type": "boolean" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["network", "filesystem:read", "filesystem:write", "process", "worker", "native"]
      }
    },
    "networkHosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "description": "Hosts de rede pretendidos, como api.example.com ou *.cdn.example.com. O downloader de artifacts do núcleo impõe esta lista.",
      "items": {
        "type": "string",
        "maxLength": 255,
        "pattern": "^(?:\\*\\.)?(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)*[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
      }
    },
    "secretKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "maxLength": 100
      }
    },
    "optionalSecretKeys": {
      "type": "array",
      "uniqueItems": true,
      "description": "Subset de secretKeys que habilita fontes ou recursos opcionais sem bloquear a execução sem conexão.",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "maxLength": 100
      }
    },
    "deliveryTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Tipos de entrega que o plugin consegue produzir ou processar. Plugins legados sem este campo são tratados como processing.",
      "items": {
        "enum": ["text", "image", "audio", "video", "processing"]
      }
    },
    "profileSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configurationKey", "label"],
      "properties": {
        "configurationKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "fallbackConfigurationKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "prepareTimeoutMs": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 900000
        }
      }
    },
    "settingsSchema": { "$ref": "#/$defs/jsonSchema" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "allOf": [
    {
      "if": { "required": ["networkHosts"] },
      "then": {
        "properties": {
          "permissions": { "contains": { "const": "network" } }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 100
    },
    "dataType": {
      "enum": [
        "text",
        "textarea",
        "number",
        "boolean",
        "list",
        "records",
        "select",
        "multiselect",
        "datetime",
        "url",
        "file",
        "files",
        "image",
        "audio",
        "video",
        "approval",
        "thumbnail_layout"
      ]
    },
    "presentation": {
      "type": "object",
      "description": "Solicitação opcional de apresentação. O renderer é implementado e controlado exclusivamente pelo núcleo.",
      "additionalProperties": false,
      "required": ["renderer"],
      "properties": {
        "renderer": {
          "enum": [
            "auto",
            "text-short",
            "text-long",
            "list",
            "tags",
            "table",
            "cards",
            "file-list",
            "image-gallery",
            "audio-player",
            "video-player",
            "decision"
          ]
        },
        "itemType": { "enum": ["text", "record", "file", "image", "audio", "video"] },
        "acceptedMimeTypes": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[-A-Za-z0-9_.+]+/[-A-Za-z0-9_.+*]+$"
          }
        }
      }
    },
    "jsonSchema": {
      "type": "object",
      "description": "JSON Schema Draft 2020-12 restricted by the protocol.",
      "additionalProperties": true
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "localizedSchemaProperty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "options": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": ["string", "number", "boolean"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        }
      }
    },
    "capabilityLocalization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "inputPorts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/localizedText" }
        },
        "outputPorts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/localizedText" }
        },
        "itemActions": {
          "type": "object",
          "propertyNames": { "enum": ["regenerate", "replace", "select", "download"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        },
        "blockConfigSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/localizedSchemaProperty" }
            }
          }
        }
      }
    },
    "manifestLocalization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "profileSetup": { "$ref": "#/$defs/localizedText" },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/capabilityLocalization" }
        }
      }
    },
    "inputPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "acceptedTypes", "required"],
      "properties": {
        "key": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "acceptedTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dataType" }
        },
        "required": { "type": "boolean" },
        "multiple": { "type": "boolean" },
        "presentation": { "$ref": "#/$defs/presentation" }
      }
    },
    "outputPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "producedTypes", "required"],
      "properties": {
        "key": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "producedTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dataType" }
        },
        "required": { "type": "boolean" },
        "presentation": { "$ref": "#/$defs/presentation" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "blockTypes",
        "inputPorts",
        "outputPorts",
        "execution",
        "sideEffects",
        "cost",
        "dataPolicy",
        "blockConfigSchema",
        "outputSchema"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "operator": { "enum": ["IA", "Código"] },
        "instructionUsage": {
          "enum": ["required", "optional", "not_applicable"],
          "description": "Declara se a capability consome a instrução resolvida do bloco. Ausência preserva compatibilidade e equivale a optional."
        },
        "blockTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["BUSCAR", "ESCOLHER", "CRIAR", "VALIDAR"] }
        },
        "processTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "theme",
              "title",
              "thumbnail",
              "script",
              "narration",
              "assets",
              "editing",
              "publishing"
            ]
          }
        },
        "inputPorts": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputPort" }
        },
        "outputPorts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outputPort" }
        },
        "acceptedInputTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dataType" }
        },
        "producedOutputTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dataType" }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["immediate", "async"] },
            "defaultTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 86400000 },
            "supportsCancellation": { "type": "boolean" },
            "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 100 },
            "itemOrchestration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["inputPort", "outputPort", "mode"],
              "properties": {
                "inputPort": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "outputPort": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "mode": { "const": "sequential" }
              }
            }
          }
        },
        "sideEffects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "external_read",
              "external_write",
              "public_publish",
              "local_artifact",
              "subprocess"
            ]
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "estimateSupported"],
          "properties": {
            "model": { "enum": ["free", "metered", "unknown"] },
            "estimateSupported": { "type": "boolean" }
          }
        },
        "dataPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sendsDataToThirdParties"],
          "properties": {
            "sendsDataToThirdParties": { "type": "boolean" },
            "providers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 160 }
            },
            "retentionPolicyUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
            "trainingPolicyUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "sendsDataToThirdParties": { "const": true } },
                "required": ["sendsDataToThirdParties"]
              },
              "then": { "required": ["providers"] }
            }
          ]
        },
        "blockConfigSchema": { "$ref": "#/$defs/jsonSchema" },
        "configurationOptions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["property", "providerId"],
            "properties": {
              "property": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "providerId": { "$ref": "#/$defs/identifier" },
              "dependsOn": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                }
              },
              "cacheTtlMs": { "type": "integer", "minimum": 0, "maximum": 86400000 }
            }
          }
        },
        "itemActions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action"],
            "properties": {
              "action": { "enum": ["regenerate", "replace", "select", "download"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        },
        "outputSchema": { "$ref": "#/$defs/jsonSchema" }
      }
    }
  }
}
