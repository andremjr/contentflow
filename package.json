    "test:asset-generation": "node --test ecosystem/plugins/reference/free-stock-media-studio/test.mjs ecosystem/tests/asset-generation-p60/test.mjs",
    "plugin:kit": "tsx ecosystem/plugin-kit/cli.ts",
    "precheck": "npm run test:execution-state-machine",
    "check": "npm run lint && npm run typecheck && npm run test:architecture && npm run test:presentation && npm run test:deliveries && npm run test:channel-history && npm run test:instructions && npm run test:method-sources && npm run test:project-title && npm run test:sandbox && npm run test:remote-artifacts && npm run test:plugin-jobs && npm run test:plugin-partials && npm run test:plugin-concurrency && npm run test:plugin-fallback && npm run test:plugin-inputs && npm run test:automatic-execution && npm run test:orchestrator && npm run test:process-order && npm run test:data-shape && npm run test:plugin-kit && npm run test:plugin-branding && npm run test:plugin-dependencies && npm run test:method-file && npm run test:method-transfer && npm run test:builder-mcp && npm run test:plugin-connections && npm run test:plugin-profiles && npm run test:plugin-options && npm run test:plugin-connection-runtime && npm run test:plugin-conversation && npm run test:plugin-package && npm run test:updater && npm run test:distribution-boundaries && npm run test:data-migration && npm run test:schema-migrations && npm run test:v121-fixture && npm run test:shared-browser-v15 && npm run test:shared-browser-v42 && npm run test:shared-browser-v43 && npm run test:shared-browser-v61 && npm run test:shared-browser-v71 && npm run test:shared-browser-v72 && npm run test:shared-browser-v73 && npm run test:shared-browser-v74 && npm run test:shared-browser-v81 && npm run test:shared-browser-v82 && npm run test:shared-browser-v83 && npm run test:shared-browser-v84 && npm run test:shared-browser-v85 && npm run test:shared-browser-v86 && npm run test:shared-browser-v87 && npm run test:shared-browser-v88 && npm run test:shared-browser-v89 && npm run test:shared-browser-v91 && npm run test:shared-browser-v92 && npm run test:shared-browser-v93 && npm run test:shared-browser-v101 && npm run test:shared-browser-v102 && npm run test:shared-browser-v103 && npm run test:shared-browser-v104 && npm run test:shared-browser-v105 && npm run test:shared-browser-v111 && npm run test:shared-browser-v112 && npm run test:shared-browser-v113 && npm run test:shared-browser-v121 && npm run test:shared-browser-v122 && npm run test:shared-browser-v123 && npm run test:shared-browser-v124 && npm run test:asset-generation && npm run test:browser-runtime-core && npm run test:browser-bridge && npm run test:browser-plugins && npm run test:skill-sync && npm run build",
