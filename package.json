    "test:plugin-profiles": "tsx --test server/plugin-profiles.test.ts server/plugin-profiles.integration.test.ts server/browser-profile-readiness.test.ts",
    "test:plugin-options": "tsx --test server/plugin-configuration-options.test.ts server/plugin-configuration-options.integration.test.ts server/plugin-declarative-capabilities.test.ts",
