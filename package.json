    "test:distribution-boundaries": "node --test desktop/distribution-boundaries.test.cjs",
    "test:data-migration": "tsx --test server/data-directory-migration.test.ts",
    "test:schema-migrations": "tsx --test server/schema-migrations.test.ts server/schema-migration-fault-injection-v23.test.ts server/browser-profiles.test.ts server/browser-profile-migration-v32.test.ts server/browser-profile-legacy-resolver-v33.test.ts",
