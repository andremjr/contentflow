{
  "name": "contentflow-os",
  "version": "0.4.1",
  "productName": "ContentFlow OS",
  "description": "Gerenciador estratégico de métodos para produção de conteúdo e plugins independentes.",
  "author": "André Marinho Jr.",
  "private": true,
  "main": "desktop/main.cjs",
  "license": "LicenseRef-ContentFlow-Source-Available-1.0",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=10"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run api\" \"vite dev --host 127.0.0.1 --port 8080\"",
    "api": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "start": "concurrently -k \"npm run api:start\" \"vite preview --host 127.0.0.1 --port 8080\"",
    "desktop:prepare": "npm run build && node desktop/prepare-desktop.mjs",
    "desktop:run": "npm run desktop:prepare && electron .",
    "desktop:portable": "npm run desktop:prepare && electron-builder --win portable --x64",
    "desktop:installer": "npm run desktop:prepare && electron-builder --win nsis --x64",
    "desktop:v0": "npm run desktop:prepare && electron-builder --win portable nsis --x64",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test:sandbox": "tsx server/plugin-sandbox-smoke.ts",
    "test:presentation": "tsx server/presentation-smoke.ts",
    "test:deliveries": "tsx --test server/deliveries.test.ts",
    "test:channel-history": "tsx --test server/channel-history.test.ts",
    "test:remote-artifacts": "tsx server/remote-artifact-downloader.test.ts",
    "test:plugin-jobs": "tsx server/plugin-job-store.test.ts",
    "test:plugin-fallback": "tsx --test server/plugin-account-fallback.test.ts server/plugin-item-orchestration.test.ts server/plugin-account-fallback.integration.test.ts",
    "test:plugin-inputs": "tsx --test server/plugin-input-values.test.ts",
    "test:automatic-execution": "tsx --test server/automatic-plugin-execution.test.ts server/execution-retry.test.ts",
    "test:orchestrator": "tsx --test server/execution-orchestrator.test.ts server/execution-orchestrator.integration.test.ts",
    "test:plugin-kit": "tsx server/plugin-kit.test.ts",
    "plugin:kit": "tsx tools/plugin-kit.ts",
    "check": "npm run lint && npm run typecheck && npm run test:presentation && npm run test:deliveries && npm run test:channel-history && npm run test:sandbox && npm run test:remote-artifacts && npm run test:plugin-jobs && npm run test:plugin-fallback && npm run test:plugin-inputs && npm run test:automatic-execution && npm run test:orchestrator && npm run test:plugin-kit && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@napi-rs/keyring": "^1.3.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.contentflow.os",
    "productName": "ContentFlow OS",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release/v0",
      "buildResources": "build"
    },
    "files": [
      "desktop/main.cjs",
      "desktop-dist/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "server",
        "to": "runtime/workers",
        "filter": [
          "plugin-worker.mjs",
          "plugin-worker.ts"
        ]
      },
      {
        "from": "plugins/bundled",
        "to": "plugins/bundled",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "plugins/examples",
        "to": "examples/plugins",
        "filter": [
          "**/*"
        ]
      },
      "LICENSE",
      "AI_USAGE_POLICY.md",
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "PLUGIN_*.md",
          "schemas/**/*",
          "examples/**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "ContentFlow-OS-V0-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "ContentFlow-OS-V0-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "ContentFlow-OS-V0-${version}-${arch}-Portable.${ext}"
    }
  }
}
