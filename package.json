    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "yauzl": "3.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tsx": "^4.23.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.contentflow.app",
    "productName": "ContentFlow",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release/v1",
      "buildResources": "build"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/updater.cjs",
      "build/icon.png",
      "desktop-dist/**/*",
      "dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "andremjr",
        "repo": "contentflow",
        "channel": "latest",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "desktop-runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "server",
        "to": "runtime/workers",
        "filter": [
          "plugin-worker.mjs",
          "plugin-worker.ts"
        ]
      },
      "LICENSE",
      "AI_USAGE_POLICY.md",
      {
        "from": "docs/ecosystem",
        "to": "docs",
        "filter": [
          "*.md",
          "schemas/**/*",
          "examples/**/*"
        ]
      },
      {
        "from": "ecosystem/browser-bridge",
        "to": "browser-bridge",
        "filter": [
          "content-script.js",
          "INSTALAR.md",
          "manifest.json",
          "README.md",
          "service-worker.js"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "ContentFlow-V1-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "ContentFlow-V1-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "ContentFlow-V1-${version}-${arch}-Portable.${ext}"
    }
  }
}
