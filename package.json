{
  "name": "contentflow-os",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run api\" \"vite dev --host 127.0.0.1 --port 8080\"",
    "api": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "start": "concurrently -k \"npm run api:start\" \"vite preview --host 127.0.0.1 --port 8080\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
