{
  "name": "contentflow",
  "version": "0.4.6",
  "productName": "ContentFlow",
  "description": "Gerenciador estratégico de métodos para produção de conteúdo e plugins independentes.",
  "author": "André Marinho Jr.",
  "repository": {
    "type": "git",
    "url": "https://github.com/andremjr/contentflow.git"
  },
  "private": true,
  "main": "desktop/main.cjs",
  "license": "LicenseRef-ContentFlow-Source-Available-1.0",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=10"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run api\" \"vite dev --host 127.0.0.1 --port 8080\"",
    "api": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "start": "concurrently -k \"npm run api:start\" \"vite preview --host 127.0.0.1 --port 8080\"",
    "desktop:prepare": "npm run build && node desktop/validate-native-dependencies.mjs && node desktop/prepare-desktop.mjs",
    "desktop:run": "npm run desktop:prepare && electron .",
    "desktop:portable": "npm run desktop:prepare && electron-builder --win portable --x64",
    "desktop:installer": "npm run desktop:prepare && electron-builder --win nsis --x64",
    "desktop:v0": "npm run desktop:prepare && electron-builder --win portable nsis --x64",
    "desktop:release": "npm run desktop:prepare && electron-builder --win portable nsis --x64 --publish always",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test:sandbox": "tsx server/plugin-sandbox-smoke.ts",
    "test:presentation": "tsx server/presentation-smoke.ts",
    "test:deliveries": "tsx --test server/deliveries.test.ts",
    "test:channel-history": "tsx --test server/channel-history.test.ts",
    "test:instructions": "tsx --test server/instruction-template.test.ts",
    "test:remote-artifacts": "tsx server/remote-artifact-downloader.test.ts",
    "test:plugin-jobs": "tsx server/plugin-job-store.test.ts",
    "test:plugin-fallback": "tsx --test server/plugin-account-fallback.test.ts server/plugin-item-orchestration.test.ts server/plugin-account-fallback.integration.test.ts",
    "test:plugin-inputs": "tsx --test server/plugin-input-values.test.ts",
    "test:automatic-execution": "tsx --test server/automatic-plugin-execution.test.ts server/execution-retry.test.ts",
    "test:orchestrator": "tsx --test server/execution-orchestrator.test.ts server/execution-orchestrator.integration.test.ts",
    "test:plugin-kit": "tsx server/plugin-kit.test.ts",
    "test:plugin-branding": "tsx --test server/plugin-branding.test.ts",
    "test:plugin-dependencies": "tsx --test server/plugin-dependencies.test.ts",
    "test:method-file": "tsx --test server/method-file.test.ts",
    "test:plugin-connections": "tsx --test server/plugin-connections.test.ts",
    "test:plugin-connection-runtime": "tsx --test server/plugin-connection-runtime.test.ts",
    "test:updater": "node --test desktop/updater.test.cjs",
    "test:data-migration": "tsx --test server/data-directory-migration.test.ts",
    "plugin:kit": "tsx ecosystem/plugin-kit/cli.ts",
    "check": "npm run lint && npm run typecheck && npm run test:presentation && npm run test:deliveries && npm run test:channel-history && npm run test:instructions && npm run test:sandbox && npm run test:remote-artifacts && npm run test:plugin-jobs && npm run test:plugin-fallback && npm run test:plugin-inputs && npm run test:automatic-execution && npm run test:orchestrator && npm run test:plugin-kit && npm run test:plugin-branding && npm run test:plugin-dependencies && npm run test:method-file && npm run test:plugin-connections && npm run test:plugin-connection-runtime && npm run test:updater && npm run test:data-migration && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@napi-rs/keyring": "^1.3.0",
    "@napi-rs/keyring-win32-x64-msvc": "1.3.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tsx": "^4.23.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.contentflow.app",
    "productName": "ContentFlow",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release/v0",
      "buildResources": "build"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/updater.cjs",
      "build/icon.png",
      "desktop-dist/**/*",
      "dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "andremjr",
        "repo": "contentflow",
        "channel": "latest",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "desktop-runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "server",
        "to": "runtime/workers",
        "filter": [
          "plugin-worker.mjs",
          "plugin-worker.ts"
        ]
      },
      "LICENSE",
      "AI_USAGE_POLICY.md",
      {
        "from": "ecosystem/docs",
        "to": "docs",
        "filter": [
          "*.md",
          "schemas/**/*",
          "examples/**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "ContentFlow-V0-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "ContentFlow-V0-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "ContentFlow-V0-${version}-${arch}-Portable.${ext}"
    }
  }
}
