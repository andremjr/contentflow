{
  "name": "contentflow",
  "version": "1.2.1",
  "productName": "ContentFlow",
  "description": "Gerenciador estratégico de métodos para produção de conteúdo e plugins independentes.",
  "author": "André Marinho Jr.",
  "repository": {
    "type": "git",
    "url": "https://github.com/andremjr/contentflow.git"
  },
  "private": true,
  "main": "desktop/main.cjs",
  "license": "LicenseRef-ContentFlow-Source-Available-1.0",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=10"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run api\" \"vite dev --host 127.0.0.1 --port 8080\"",
    "api": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "start": "concurrently -k \"npm run api:start\" \"vite preview --host 127.0.0.1 --port 8080\"",
    "desktop:prepare": "npm run build && node desktop/validate-native-dependencies.mjs && node desktop/prepare-desktop.mjs",
    "desktop:run": "npm run desktop:prepare && electron .",
    "desktop:portable": "npm run desktop:prepare && electron-builder --win portable --x64",
    "desktop:installer": "npm run desktop:prepare && electron-builder --win nsis --x64",
    "desktop:v1": "npm run desktop:prepare && electron-builder --win portable nsis --x64 --publish never",
    "desktop:release": "npm run desktop:prepare && electron-builder --win portable nsis --x64 --publish never",
    "ecosystem:package": "node scripts/package-ecosystem.mjs",
    "ecosystem:catalog": "node scripts/prepare-official-catalog.mjs",
    "github:capacity": "node scripts/github-capacity-report.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test:e2e": "playwright test",
    "test:electron": "npm run desktop:prepare && playwright test --config playwright.electron.config.ts",
    "test:browser-bridge": "node --test server/browser-bridge-client.test.mjs server/browser-bridge-contract-v05.test.mjs",
    "test:browser-runtime-core": "tsx --test server/browser-session-manager.test.ts server/execution-recovery-policy.test.ts && node --test server/browser-bridge-sdk-sync.test.mjs",
