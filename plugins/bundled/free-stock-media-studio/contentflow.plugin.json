{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "local.contentflow.free-stock-media-studio",
  "name": "Free Stock Media Studio",
  "version": "0.2.1",
  "description": "Pesquisa e baixa imagens e vídeos de bancos gratuitos e acervos abertos com proveniência, licença e atribuição preservadas.",
  "author": "André Marinho Jr.",
  "license": "Proprietary",
  "runtime": { "kind": "node", "version": ">=26 <27", "module": "esm" },
  "minCoreVersion": "0.3.0",
  "entrypoint": "handler.mjs",
  "permissions": ["network", "filesystem:write"],
  "networkHosts": [
    "api.pexels.com",
    "images.pexels.com",
    "videos.pexels.com",
    "pixabay.com",
    "*.pixabay.com",
    "api.unsplash.com",
    "images.unsplash.com",
    "api.coverr.co",
    "storage.coverr.co",
    "cdn.coverr.co",
    "coverr.co",
    "api.openverse.org",
    "commons.wikimedia.org",
    "upload.wikimedia.org",
    "images-api.nasa.gov",
    "images-assets.nasa.gov"
  ],
  "secretKeys": ["PEXELS_API_KEY", "PIXABAY_API_KEY", "UNSPLASH_ACCESS_KEY", "COVERR_API_KEY"],
  "deliveryTypes": ["image", "video", "processing"],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 3000,
        "maximum": 120000,
        "default": 30000
      },
      "maxImageBytes": {
        "type": "integer",
        "minimum": 1048576,
        "maximum": 104857600,
        "default": 52428800
      },
      "maxVideoBytes": {
        "type": "integer",
        "minimum": 1048576,
        "maximum": 1073741824,
        "default": 536870912
      },
      "diagnosticFixture": {
        "type": "boolean",
        "default": false,
        "description": "Somente para testes locais; não acessa provedores."
      }
    }
  },
  "capabilities": [
    {
      "id": "search-stock-images",
      "operator": "Código",
      "blockTypes": ["BUSCAR"],
      "processTypes": ["thumbnail", "assets", "editing"],
      "inputPorts": [
        {
          "key": "query",
          "label": "Termos de busca",
          "acceptedTypes": ["text", "textarea", "list"],
          "required": true,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "results",
          "label": "Imagens encontradas",
          "producedTypes": ["records"],
          "required": true,
          "presentation": { "renderer": "cards", "itemType": "record" }
        },
        {
          "key": "warnings",
          "label": "Avisos dos provedores",
          "producedTypes": ["list"],
          "required": false,
          "presentation": { "renderer": "list", "itemType": "text" }
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "list"],
      "producedOutputTypes": ["records", "list"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 180000,
        "supportsCancellation": true,
        "maxConcurrency": 3
      },
      "sideEffects": ["external_read"],
      "cost": { "model": "free", "estimateSupported": false },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Pexels", "Pixabay", "Unsplash", "Openverse", "Wikimedia Commons", "NASA"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "default": "all",
            "enum": ["all", "pexels", "pixabay", "unsplash", "openverse", "wikimedia", "nasa"]
          },
          "resultsPerProvider": { "type": "integer", "minimum": 1, "maximum": 20, "default": 6 },
          "page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 },
          "orientation": {
            "type": "string",
            "default": "any",
            "enum": ["any", "landscape", "portrait", "square"]
          },
          "safeSearch": { "type": "boolean", "default": true }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": { "results": { "type": "array" }, "warnings": { "type": "array" } },
        "required": ["results"]
      }
    },
    {
      "id": "search-stock-videos",
      "operator": "Código",
      "blockTypes": ["BUSCAR"],
      "processTypes": ["assets", "editing"],
      "inputPorts": [
        {
          "key": "query",
          "label": "Termos de busca",
          "acceptedTypes": ["text", "textarea", "list"],
          "required": true,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "results",
          "label": "Vídeos encontrados",
          "producedTypes": ["records"],
          "required": true,
          "presentation": { "renderer": "cards", "itemType": "record" }
        },
        {
          "key": "warnings",
          "label": "Avisos dos provedores",
          "producedTypes": ["list"],
          "required": false,
          "presentation": { "renderer": "list", "itemType": "text" }
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "list"],
      "producedOutputTypes": ["records", "list"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 180000,
        "supportsCancellation": true,
        "maxConcurrency": 3
      },
      "sideEffects": ["external_read"],
      "cost": { "model": "free", "estimateSupported": false },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Pexels", "Pixabay", "Coverr", "Wikimedia Commons", "NASA"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "default": "all",
            "enum": ["all", "pexels", "pixabay", "coverr", "wikimedia", "nasa"]
          },
          "resultsPerProvider": { "type": "integer", "minimum": 1, "maximum": 20, "default": 6 },
          "page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 },
          "orientation": {
            "type": "string",
            "default": "any",
            "enum": ["any", "landscape", "portrait"]
          },
          "safeSearch": { "type": "boolean", "default": true }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": { "results": { "type": "array" }, "warnings": { "type": "array" } },
        "required": ["results"]
      }
    },
    {
      "id": "download-stock-image",
      "operator": "Código",
      "blockTypes": ["CRIAR"],
      "processTypes": ["thumbnail", "assets", "editing"],
      "inputPorts": [
        {
          "key": "asset",
          "label": "Imagem stock escolhida",
          "acceptedTypes": ["records"],
          "required": true,
          "multiple": false
        }
      ],
      "outputPorts": [
        {
          "key": "image",
          "label": "Imagem baixada",
          "producedTypes": ["image"],
          "required": true,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "provenance",
          "label": "Proveniência e atribuição",
          "producedTypes": ["records"],
          "required": true,
          "presentation": { "renderer": "table", "itemType": "record" }
        }
      ],
      "acceptedInputTypes": ["records"],
      "producedOutputTypes": ["image", "records"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 600000,
        "supportsCancellation": true,
        "maxConcurrency": 2
      },
      "sideEffects": ["external_read", "external_write", "local_artifact"],
      "cost": { "model": "free", "estimateSupported": false },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Pexels", "Pixabay", "Unsplash", "Openverse", "Wikimedia Commons", "NASA"]
      },
      "blockConfigSchema": { "type": "object", "additionalProperties": false, "properties": {} },
      "outputSchema": {
        "type": "object",
        "properties": { "image": { "type": "object" }, "provenance": { "type": "array" } },
        "required": ["image", "provenance"]
      }
    },
    {
      "id": "download-stock-video",
      "operator": "Código",
      "blockTypes": ["CRIAR"],
      "processTypes": ["assets", "editing"],
      "inputPorts": [
        {
          "key": "asset",
          "label": "Vídeo stock escolhido",
          "acceptedTypes": ["records"],
          "required": true,
          "multiple": false
        }
      ],
      "outputPorts": [
        {
          "key": "video",
          "label": "Vídeo baixado",
          "producedTypes": ["video"],
          "required": true,
          "presentation": {
            "renderer": "video-player",
            "itemType": "video",
            "acceptedMimeTypes": ["video/*"]
          }
        },
        {
          "key": "provenance",
          "label": "Proveniência e atribuição",
          "producedTypes": ["records"],
          "required": true,
          "presentation": { "renderer": "table", "itemType": "record" }
        }
      ],
      "acceptedInputTypes": ["records"],
      "producedOutputTypes": ["video", "records"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_read", "external_write", "local_artifact"],
      "cost": { "model": "free", "estimateSupported": false },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Pexels", "Pixabay", "Coverr", "Wikimedia Commons", "NASA"]
      },
      "blockConfigSchema": { "type": "object", "additionalProperties": false, "properties": {} },
      "outputSchema": {
        "type": "object",
        "properties": { "video": { "type": "object" }, "provenance": { "type": "array" } },
        "required": ["video", "provenance"]
      }
    }
  ]
}
