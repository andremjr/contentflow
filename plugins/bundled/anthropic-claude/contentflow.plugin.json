{
  "$schema": "../../../docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "official-anthropic-claude",
  "name": "Anthropic Claude",
  "version": "1.0.0",
  "description": "Executa ações baseadas em linguagem com modelos Claude disponíveis na API da Anthropic.",
  "author": "ContentFlow OS",
  "license": "LicenseRef-ContentFlow-Source-Available-1.0",
  "homepage": "https://github.com/andremjr/contentflow-os",
  "repository": "https://github.com/andremjr/contentflow-os",
  "runtime": {
    "kind": "node",
    "version": ">=22",
    "module": "esm"
  },
  "entrypoint": "handler.ts",
  "permissions": ["network"],
  "networkHosts": ["api.anthropic.com"],
  "secretKeys": ["ANTHROPIC_API_KEY"],
  "deliveryTypes": ["text"],
  "capabilities": [
    {
      "id": "generate-or-validate-text",
      "operator": "IA",
      "blockTypes": ["BUSCAR", "ESCOLHER", "CRIAR", "VALIDAR"],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "context",
          "label": "Contexto",
          "acceptedTypes": [
            "text",
            "textarea",
            "number",
            "boolean",
            "list",
            "records",
            "select",
            "multiselect",
            "datetime",
            "url",
            "approval",
            "thumbnail_layout"
          ],
          "required": false,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Resultado",
          "producedTypes": [
            "text",
            "textarea",
            "number",
            "boolean",
            "list",
            "records",
            "select",
            "multiselect",
            "datetime",
            "url",
            "approval"
          ],
          "required": true
        }
      ],
      "acceptedInputTypes": [
        "text",
        "textarea",
        "number",
        "boolean",
        "list",
        "records",
        "select",
        "multiselect",
        "datetime",
        "url",
        "approval",
        "thumbnail_layout"
      ],
      "producedOutputTypes": [
        "text",
        "textarea",
        "number",
        "boolean",
        "list",
        "records",
        "select",
        "multiselect",
        "datetime",
        "url",
        "approval"
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 120000,
        "supportsCancellation": false,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_read", "external_write"],
      "cost": { "model": "metered", "estimateSupported": false },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Anthropic"],
        "retentionPolicyUrl": "https://privacy.anthropic.com/en/articles/7996866-how-long-do-you-store-my-organization-s-data",
        "trainingPolicyUrl": "https://privacy.anthropic.com/en/articles/7996868-is-my-data-used-for-model-training"
      },
      "blockConfigSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "title": "Modelo Claude",
            "description": "A disponibilidade depende da sua conta Anthropic.",
            "default": "claude-sonnet-4-6",
            "oneOf": [
              { "const": "claude-opus-4-6", "title": "Claude Opus 4.6" },
              { "const": "claude-sonnet-4-6", "title": "Claude Sonnet 4.6" },
              { "const": "claude-haiku-4-5", "title": "Claude Haiku 4.5" }
            ]
          },
          "system_prompt": {
            "type": "string",
            "title": "Prompt de sistema",
            "format": "textarea",
            "default": "Execute as instruções do bloco usando o contexto disponível e respeite exatamente o contrato de saída."
          },
          "temperature": {
            "type": "number",
            "title": "Temperatura",
            "minimum": 0,
            "maximum": 1,
            "default": 0.7
          },
          "max_tokens": {
            "type": "number",
            "title": "Máximo de tokens de saída",
            "minimum": 1,
            "maximum": 64000,
            "default": 4096
          }
        }
      },
      "outputSchema": { "type": "object" }
    }
  ]
}
