{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow-os/main/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "official-edge-tts",
  "name": "Microsoft Edge TTS",
  "version": "1.0.0",
  "description": "Gera narração MP3 com as vozes online gratuitas usadas pelo recurso Ler em voz alta do Microsoft Edge.",
  "author": "ContentFlow OS",
  "license": "LicenseRef-ContentFlow-Source-Available-1.0",
  "homepage": "https://github.com/andremjr/contentflow-os",
  "repository": "https://github.com/andremjr/contentflow-os",
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.4.1",
  "entrypoint": "handler.mjs",
  "permissions": ["network", "filesystem:read", "filesystem:write", "process"],
  "networkHosts": ["speech.platform.bing.com"],
  "deliveryTypes": ["audio", "processing"],
  "capabilities": [
    {
      "id": "text-to-speech",
      "operator": "Código",
      "blockTypes": ["CRIAR"],
      "processTypes": ["narration"],
      "inputPorts": [
        {
          "key": "text",
          "label": "Texto da narração",
          "description": "Texto enviado ao serviço online de leitura do Microsoft Edge.",
          "acceptedTypes": ["text", "textarea"],
          "required": true,
          "multiple": false
        }
      ],
      "outputPorts": [
        {
          "key": "audio",
          "label": "Narração Edge TTS",
          "description": "Arquivo MP3 mono gerado pelo serviço do Microsoft Edge.",
          "producedTypes": ["audio"],
          "required": true,
          "presentation": {
            "renderer": "audio-player",
            "itemType": "audio",
            "acceptedMimeTypes": ["audio/mpeg"]
          }
        }
      ],
      "acceptedInputTypes": ["text", "textarea"],
      "producedOutputTypes": ["audio"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 120000,
        "supportsCancellation": false,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": {
        "model": "free",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Microsoft Edge online TTS"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voice": {
            "type": "string",
            "title": "Voz",
            "description": "ShortName de uma voz neural disponível no Edge TTS.",
            "pattern": "^[a-z]{2,3}-[A-Z]{2}-[A-Za-z0-9]+Neural$",
            "default": "en-US-GuyNeural"
          },
          "ratePercent": {
            "type": "integer",
            "title": "Velocidade (%)",
            "minimum": -50,
            "maximum": 100,
            "default": 0
          },
          "volumePercent": {
            "type": "integer",
            "title": "Volume (%)",
            "minimum": -50,
            "maximum": 100,
            "default": 0
          },
          "pitchHz": {
            "type": "integer",
            "title": "Tom (Hz)",
            "minimum": -100,
            "maximum": 100,
            "default": 0
          }
        },
        "required": ["voice", "ratePercent", "volumePercent", "pitchHz"]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string", "pattern": "\\.mp3$" },
              "mimeType": { "const": "audio/mpeg" },
              "size": { "type": "integer", "minimum": 1 },
              "url": { "type": "string", "pattern": "^artifact://" }
            },
            "required": ["id", "name", "mimeType", "size", "url"]
          }
        },
        "required": ["audio"]
      }
    }
  ]
}
