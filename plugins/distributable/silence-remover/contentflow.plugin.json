{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow-os/main/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "official-silence-remover",
  "name": "Removedor de Silêncios",
  "version": "1.0.1",
  "description": "Remove trechos silenciosos de arquivos de áudio e vídeo com parâmetros configuráveis.",
  "author": "ContentFlow OS",
  "license": "LicenseRef-ContentFlow-Source-Available-1.0",
  "homepage": "https://github.com/andremjr/contentflow-os",
  "repository": "https://github.com/andremjr/contentflow-os",
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.2.0",
  "entrypoint": "handler.mjs",
  "permissions": ["filesystem:read", "filesystem:write", "process"],
  "deliveryTypes": ["audio", "video", "processing"],
  "capabilities": [
    {
      "id": "remove-silence-audio",
      "operator": "Código",
      "blockTypes": ["CRIAR"],
      "processTypes": ["narration", "editing"],
      "inputPorts": [
        {
          "key": "source",
          "label": "Áudio de origem",
          "description": "Arquivo de áudio que será analisado e recortado.",
          "acceptedTypes": ["audio"],
          "required": true,
          "presentation": {
            "renderer": "audio-player",
            "itemType": "audio",
            "acceptedMimeTypes": [
              "audio/aac",
              "audio/flac",
              "audio/mp3",
              "audio/mp4",
              "audio/mpeg",
              "audio/ogg",
              "audio/opus",
              "audio/wav",
              "audio/webm",
              "audio/x-flac",
              "audio/x-m4a",
              "audio/x-wav"
            ]
          }
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Áudio sem silêncios",
          "description": "Novo áudio com os intervalos silenciosos removidos.",
          "producedTypes": ["audio"],
          "required": true,
          "presentation": {
            "renderer": "audio-player",
            "itemType": "audio",
            "acceptedMimeTypes": ["audio/*"]
          }
        }
      ],
      "acceptedInputTypes": ["audio"],
      "producedOutputTypes": ["audio"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 120000,
        "supportsCancellation": false,
        "maxConcurrency": 1
      },
      "sideEffects": ["local_artifact", "subprocess"],
      "cost": {
        "model": "free",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": false
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "minimumSilenceDurationMs": {
            "type": "integer",
            "title": "Silêncio mínimo para cortar (ms)",
            "description": "Trechos silenciosos menores que este valor são preservados.",
            "minimum": 100,
            "maximum": 60000,
            "default": 500
          },
          "silenceThresholdDb": {
            "type": "number",
            "title": "Limiar de silêncio (dB)",
            "description": "Som abaixo deste nível é considerado silêncio. Valores mais próximos de zero são mais agressivos.",
            "minimum": -96,
            "maximum": -1,
            "default": -40
          },
          "paddingMs": {
            "type": "integer",
            "title": "Margem preservada (ms)",
            "description": "Mantém esta margem em cada transição para evitar cortes secos em palavras e respirações.",
            "minimum": 0,
            "maximum": 2000,
            "default": 100
          }
        },
        "required": ["minimumSilenceDurationMs", "silenceThresholdDb", "paddingMs"]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "mimeType": { "type": "string", "pattern": "^audio/" },
              "size": { "type": "integer", "minimum": 1 },
              "url": { "type": "string", "pattern": "^artifact://" }
            },
            "required": ["id", "name", "mimeType", "size", "url"]
          }
        },
        "required": ["result"]
      }
    },
    {
      "id": "remove-silence-video",
      "operator": "Código",
      "blockTypes": ["CRIAR"],
      "processTypes": ["editing"],
      "inputPorts": [
        {
          "key": "source",
          "label": "Vídeo de origem",
          "description": "Arquivo de vídeo com uma faixa de áudio que será usada para detectar os cortes.",
          "acceptedTypes": ["video"],
          "required": true,
          "presentation": {
            "renderer": "video-player",
            "itemType": "video",
            "acceptedMimeTypes": [
              "video/avi",
              "video/mp4",
              "video/quicktime",
              "video/webm",
              "video/x-matroska",
              "video/x-msvideo"
            ]
          }
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Vídeo sem silêncios",
          "description": "Novo vídeo com imagem e áudio recortados nos mesmos intervalos.",
          "producedTypes": ["video"],
          "required": true,
          "presentation": {
            "renderer": "video-player",
            "itemType": "video",
            "acceptedMimeTypes": ["video/*"]
          }
        }
      ],
      "acceptedInputTypes": ["video"],
      "producedOutputTypes": ["video"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 120000,
        "supportsCancellation": false,
        "maxConcurrency": 1
      },
      "sideEffects": ["local_artifact", "subprocess"],
      "cost": {
        "model": "free",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": false
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "minimumSilenceDurationMs": {
            "type": "integer",
            "title": "Silêncio mínimo para cortar (ms)",
            "description": "Trechos silenciosos menores que este valor são preservados.",
            "minimum": 100,
            "maximum": 60000,
            "default": 500
          },
          "silenceThresholdDb": {
            "type": "number",
            "title": "Limiar de silêncio (dB)",
            "description": "Som abaixo deste nível é considerado silêncio. Valores mais próximos de zero são mais agressivos.",
            "minimum": -96,
            "maximum": -1,
            "default": -40
          },
          "paddingMs": {
            "type": "integer",
            "title": "Margem preservada (ms)",
            "description": "Mantém esta margem em cada transição para evitar cortes secos em palavras e respirações.",
            "minimum": 0,
            "maximum": 2000,
            "default": 100
          }
        },
        "required": ["minimumSilenceDurationMs", "silenceThresholdDb", "paddingMs"]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "mimeType": { "type": "string", "pattern": "^video/" },
              "size": { "type": "integer", "minimum": 1 },
              "url": { "type": "string", "pattern": "^artifact://" }
            },
            "required": ["id", "name", "mimeType", "size", "url"]
          }
        },
        "required": ["result"]
      }
    }
  ]
}
