          "required": false,
          "presentation": { "renderer": "list" }
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "list", "records", "url"],
      "producedOutputTypes": ["textarea", "list"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_read", "external_write", "subprocess"],
      "cost": { "model": "unknown", "estimateSupported": false },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["OpenAI / ChatGPT web", "Fontes públicas acessadas pela pesquisa"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "searchPromptTemplate": {
            "type": "string",
            "format": "textarea",
            "default": "Pesquise a web e responda com informações atuais, diferenciando fatos de inferências e citando fontes.\n\nCONSULTA:\n{{QUERY}}\n\nCONTEXTO:\n{{SEARCH_CONTEXT}}"
          },
          "maxSources": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
          "retryAttempts": { "type": "integer", "minimum": 0, "maximum": 3, "default": 1 }
        }
      },
      "outputSchema": { "type": "object" }
    },
