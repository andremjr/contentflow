{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow-os/main/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "local.contentflow.chatgpt-browser-studio",
  "name": "ChatGPT Browser Studio",
  "version": "0.1.15",
  "description": "Automação modular do ChatGPT web para criar, pesquisar, escolher, validar, analisar arquivos e gerar imagens.",
  "author": "André Marinho Jr.",
  "license": "Proprietary",
  "runtime": { "kind": "node", "version": ">=26 <27", "module": "esm" },
  "minCoreVersion": "0.3.0",
  "entrypoint": "handler.mjs",
  "permissions": ["network", "filesystem:read", "filesystem:write", "process"],
  "networkHosts": ["chatgpt.com", "files.oaiusercontent.com"],
  "deliveryTypes": ["text", "image", "processing"],
  "profileSetup": {
    "configurationKey": "accountProfile",
    "label": "Salvar perfil",
    "description": "Abre o ChatGPT para login e fecha o Chrome após validar a área do chat.",
    "prepareTimeoutMs": 900000
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chromeExecutable": {
        "type": "string",
        "default": "",
        "description": "Caminho opcional do Google Chrome."
      },
      "profilesBasePath": {
        "type": "string",
        "default": "",
        "description": "Pasta-base opcional dos perfis ChatGPT. Vazio usa o workspace autorizado do plugin."
      },
      "remoteDebuggingPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 64000,
        "default": 9544
      },
      "keepBrowserOpen": { "type": "boolean", "default": false },
      "startMinimized": { "type": "boolean", "default": false },
      "interactiveWaitSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 600
      },
      "responseTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 3600,
        "default": 600
      },
      "typingChunkSize": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
      "typingDelayMs": { "type": "integer", "minimum": 0, "maximum": 200, "default": 10 },
      "diagnosticTrace": {
        "type": "boolean",
        "default": false,
        "description": "Registra apenas etapas e tamanhos redigidos."
      },
      "diagnosticMockResponse": {
        "type": "string",
        "default": "",
        "description": "Somente para testes locais; não abre navegador."
      }
    }
  },
  "capabilities": [
    {
      "id": "generate-text-in-browser",
      "operator": "IA",
      "blockTypes": ["CRIAR"],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "content",
          "label": "Contexto para geração",
          "acceptedTypes": [
            "text",
            "textarea",
            "number",
            "boolean",
            "list",
            "records",
            "select",
            "multiselect",
            "datetime",
            "url",
            "thumbnail_layout"
          ],
          "required": false,
          "multiple": true
        },
        {
          "key": "outline",
          "label": "Outline / estrutura",
          "acceptedTypes": ["records", "list"],
          "required": false,
          "multiple": false
        },
        {
          "key": "attachments",
          "label": "Referências anexas",
          "acceptedTypes": ["image", "file", "files"],
          "required": false,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Texto gerado",
          "producedTypes": ["text", "textarea"],
          "required": true,
          "presentation": { "renderer": "text-long" }
        },
        {
          "key": "parts",
          "label": "Respostas por etapa",
          "producedTypes": ["list"],
          "required": false,
          "presentation": { "renderer": "list" }
        }
      ],
      "acceptedInputTypes": [
        "text",
        "textarea",
        "number",
        "boolean",
        "list",
        "records",
        "select",
        "multiselect",
        "datetime",
        "url",
        "thumbnail_layout",
        "image",
        "file",
        "files"
      ],
      "producedOutputTypes": ["text", "textarea", "list"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "subprocess"],
      "cost": { "model": "unknown", "estimateSupported": false },
      "dataPolicy": { "sendsDataToThirdParties": true, "providers": ["OpenAI / ChatGPT web"] },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "title": "Perfil da conta ChatGPT",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "promptTemplate": {
            "type": "string",
            "title": "Template do prompt",
            "format": "textarea",
            "default": "{{BLOCK_INSTRUCTIONS}}\n\nCONTEXTO:\n{{CONTENT}}\n\nEntregue somente o conteúdo final solicitado."
          },
          "generationMode": {
            "type": "string",
            "title": "Modo",
            "default": "single",
            "oneOf": [
              { "const": "single", "title": "Uma resposta" },
              { "const": "legacy_script_3_parts", "title": "Roteiro legado em 3 partes" },
              { "const": "outline_sequence", "title": "Outline dinâmica" },
              { "const": "custom_parts", "title": "Partes personalizadas" }
            ]
          },
          "outlineFirstPromptTemplate": {
            "type": "string",
            "title": "Primeiro bloco",
            "format": "textarea",
            "default": "{{PROMPT_BASE}}\n\nDesenvolva somente o bloco {{BLOCK_NUMBER}}/{{BLOCK_TOTAL}}. Faça a abertura necessária.\n\n{{BLOCK}}"
          },
          "outlineNextPromptTemplate": {
            "type": "string",
            "title": "Blocos intermediários",
            "format": "textarea",
            "default": "Continue de onde parou. Desenvolva somente o bloco {{BLOCK_NUMBER}}/{{BLOCK_TOTAL}}, sem repetir ou antecipar.\n\n{{BLOCK}}"
          },
          "outlineLastPromptTemplate": {
            "type": "string",
            "title": "Último bloco",
            "format": "textarea",
            "default": "Continue de onde parou. Desenvolva o último bloco {{BLOCK_NUMBER}}/{{BLOCK_TOTAL}} e conclua.\n\n{{BLOCK}}"
          },
          "customParts": {
            "type": "string",
            "title": "Partes personalizadas",
            "format": "textarea",
            "default": "",
            "description": "Separe por uma linha ---PARTE---."
          },
          "reasoningMode": {
            "type": "string",
            "title": "Raciocínio",
            "default": "standard",
            "oneOf": [
              { "const": "standard", "title": "Padrão" },
              { "const": "think", "title": "Think" }
            ]
          },
          "plainTextOnly": { "type": "boolean", "title": "Texto puro", "default": true },
          "cleanOutput": { "type": "boolean", "title": "Limpar formatação", "default": true },
          "minCharacters": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 1 },
          "delayBetweenPartsMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000,
            "default": 2000
          },
          "retryAttempts": { "type": "integer", "minimum": 0, "maximum": 3, "default": 1 }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": { "type": "string", "minLength": 1 },
          "parts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["result"]
      }
    },
    {
      "id": "search-web-in-browser",
      "operator": "IA",
      "blockTypes": ["BUSCAR"],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "query",
          "label": "Consulta",
          "acceptedTypes": ["text", "textarea", "list"],
          "required": true,
          "multiple": true
        },
        {
          "key": "context",
          "label": "Contexto",
          "acceptedTypes": ["text", "textarea", "list", "records", "url"],
          "required": false,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Resultado",
          "producedTypes": ["textarea"],
          "required": true,
          "presentation": { "renderer": "text-long" }
        },
        {
          "key": "sources",
          "label": "Fontes",
