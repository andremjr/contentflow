            "format": "textarea",
            "default": "Analise cuidadosamente as imagens anexadas. Descreva somente o que é visualmente sustentado e sinalize incertezas.\n\nTAREFA:\n{{BLOCK_INSTRUCTIONS}}\n\nCONTEXTO:\n{{ANALYSIS_CONTEXT}}"
          },
          "retryAttempts": {
            "type": "integer",
            "title": "Novas tentativas",
            "minimum": 0,
            "maximum": 3,
            "default": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "result": { "type": "string", "minLength": 1 } },
        "required": ["result"]
      }
    },
    {
