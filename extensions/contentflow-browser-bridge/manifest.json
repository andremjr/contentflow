{
  "manifest_version": 3,
  "name": "ContentFlow Browser Bridge",
  "version": "0.1.0",
  "description": "Ponte comum dos plugins de automação de navegador compatíveis com o ContentFlow OS.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://labs.google/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
