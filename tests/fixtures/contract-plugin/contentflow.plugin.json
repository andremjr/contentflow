{
  "apiVersion": "2",
  "id": "com.contentflow.e2e-contract",
  "name": "Plugin de Contrato E2E",
  "version": "1.0.0",
  "description": "Fixture isolada para validar binding explícito de portas.",
  "author": "ContentFlow Tests",
  "license": "Proprietary",
  "runtime": { "kind": "node", "version": ">=26 <27", "module": "esm" },
  "entrypoint": "handler.mjs",
  "permissions": [],
  "capabilities": [
    {
      "id": "generate",
      "operator": "IA",
      "instructionUsage": "required",
      "blockTypes": ["CRIAR"],
      "processTypes": ["script"],
      "inputPorts": [
        {
          "key": "content",
          "label": "Contexto",
          "shape": { "kind": "content", "family": "text", "cardinality": "many", "representation": "inline" },
          "required": false
        },
        {
          "key": "outline",
          "label": "Outline / estrutura",
          "shape": { "kind": "content", "family": "text", "cardinality": "many", "representation": "inline" },
          "required": false
        },
        {
          "key": "sections",
          "label": "Quantidade de blocos",
          "shape": { "kind": "control", "control": "number", "cardinality": "one" },
          "required": false
        }
      ],
      "outputPorts": [
        { "key": "result", "label": "Resultado", "shape": { "kind": "content", "family": "text", "cardinality": "one", "representation": "inline" }, "required": true }
      ],
      "execution": { "mode": "immediate", "defaultTimeoutMs": 30000, "maxConcurrency": 1 },
      "sideEffects": [],
      "cost": { "model": "free", "estimateSupported": false },
      "dataPolicy": { "sendsDataToThirdParties": false },
      "blockConfigSchema": { "type": "object", "additionalProperties": false, "properties": {} },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "result": { "type": "string" } },
        "required": ["result"]
      }
    }
  ]
}
