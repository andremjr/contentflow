{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v2.schema.json",
  "apiVersion": "2",
  "id": "com.contentflow.kit-text-demo",
  "name": "ContentFlow Kit Text Demo",
  "version": "0.1.0",
  "description": "Exemplo mínimo criado pelo próprio Plugin Kit oficial.",
  "author": "ContentFlow",
  "license": "LicenseRef-ContentFlow-Plugin-Example-1.0",
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "entrypoint": "handler.mjs",
  "permissions": [],
  "capabilities": [
    {
      "id": "demo",
      "operator": "Código",
      "blockTypes": [
        "CRIAR"
      ],
      "inputPorts": [
        {
          "key": "content",
          "label": "Texto",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Resultado",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 30000
      },
      "sideEffects": [],
      "cost": {
        "model": "free",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": false
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ]
      }
    }
  ]
}
