{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/ecosystem/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "com.contentflow.kit-text-demo",
  "name": "ContentFlow Kit Text Demo",
  "version": "0.1.0",
  "description": "Exemplo mínimo criado pelo próprio Plugin Kit oficial.",
  "author": "ContentFlow",
  "license": "LicenseRef-ContentFlow-Plugin-Example-1.0",
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "entrypoint": "handler.mjs",
  "permissions": [],
  "deliveryTypes": ["text"],
  "capabilities": [
    {
      "id": "demo",
      "operator": "Código",
      "blockTypes": ["CRIAR"],
      "inputPorts": [
        {
          "key": "content",
          "label": "Texto",
          "acceptedTypes": ["textarea"],
          "required": true
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Resultado",
          "producedTypes": ["textarea"],
          "required": true
        }
      ],
      "acceptedInputTypes": ["textarea"],
      "producedOutputTypes": ["textarea"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 30000
      },
      "sideEffects": [],
      "cost": {
        "model": "free",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": false
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": ["result"]
      }
    }
  ]
}
