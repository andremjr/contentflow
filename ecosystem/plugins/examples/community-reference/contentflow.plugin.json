{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v2.schema.json",
  "apiVersion": "2",
  "id": "com.contentflow.reference-community",
  "name": "Plugin comunitário de referência",
  "version": "1.0.0",
  "description": "Exemplo mínimo que recebe texto, cria um arquivo e devolve o resultado.",
  "author": "ContentFlow",
  "license": "MIT",
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "entrypoint": "handler.mjs",
  "permissions": [
    "filesystem:write"
  ],
  "capabilities": [
    {
      "id": "save-text",
      "operator": "Código",
      "blockTypes": [
        "CRIAR"
      ],
      "inputPorts": [
        {
          "key": "content",
          "label": "Conteúdo",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Arquivo criado",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "artifact"
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 60000,
        "supportsCancellation": true,
        "maxConcurrency": 2
      },
      "sideEffects": [
        "local_artifact"
      ],
      "cost": {
        "model": "free",
        "estimateSupported": true
      },
      "dataPolicy": {
        "sendsDataToThirdParties": false
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    }
  ]
}
