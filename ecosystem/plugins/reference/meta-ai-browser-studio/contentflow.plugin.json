{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "local.contentflow.meta-ai-browser-studio",
  "name": "Meta AI Browser Studio",
  "version": "1.0.5",
  "description": "Gera texto e imagens no Meta AI e vídeos curtos no Vibes usando um perfil Chrome dedicado, sem API oficial.",
  "author": "André Marinho Jr.",
  "license": "Proprietary",
  "branding": {
    "iconPath": "assets/icon.png"
  },
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.3.0",
  "entrypoint": "handler.mjs",
  "permissions": ["network", "filesystem:read", "filesystem:write", "process"],
  "networkHosts": ["meta.ai", "www.meta.ai", "facebook.com", "*.fbcdn.net"],
  "deliveryTypes": ["text", "image", "video", "processing"],
  "profileSetup": {
    "configurationKey": "accountProfile",
    "fallbackConfigurationKey": "fallbackAccountProfiles",
    "label": "Salvar perfil",
    "description": "Abre o Meta AI para login e fecha o Chrome depois de validar o chat."
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chromeExecutable": {
        "type": "string",
        "default": ""
      },
      "profilesBasePath": {
        "type": "string",
        "default": ""
      },
      "allowExistingChromeProfile": {
        "type": "boolean",
        "default": false,
        "description": "Permite usar uma pasta de perfil Chrome existente escolhida explicitamente. Feche outras instâncias que estejam usando o mesmo perfil."
      },
      "remoteDebuggingPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 64000,
        "default": 9844
      },
      "keepBrowserOpen": {
        "type": "boolean",
        "default": false
      },
      "startMinimized": {
        "type": "boolean",
        "default": true
      },
      "interactiveWaitSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 600
      },
      "responseTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 3600,
        "default": 900
      },
      "typingChunkSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 10
      },
      "typingDelayMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200,
        "default": 10
      },
      "diagnosticTrace": {
        "type": "boolean",
        "default": false
      },
      "diagnosticMockResponse": {
        "type": "string",
        "default": ""
      },
      "queueDelayMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 60000,
        "default": 1500
      }
    }
  },
  "localizations": {
    "en": {
      "capabilities": {
        "generate-image-in-browser": {
          "outputPorts": {
            "image": { "label": "Generated image" },
            "images": {
              "label": "Generated images",
              "description": "All new image variants materialized from this generation."
            },
            "description": { "label": "Description" }
          },
          "itemActions": {
            "regenerate": { "label": "Regenerate" },
            "replace": { "label": "Replace" },
            "select": { "label": "Select" },
            "download": { "label": "Download" }
          },
          "blockConfigSchema": {
            "properties": {
              "aspectRatio": {
                "title": "Aspect ratio",
                "description": "Requested image aspect ratio.",
                "options": [
                  { "value": "16:9", "label": "Landscape (16:9)" },
                  { "value": "1:1", "label": "Square (1:1)" },
                  { "value": "9:16", "label": "Portrait (9:16)" }
                ]
              }
            }
          }
        },
        "animate-image-in-browser": {
          "inputPorts": {
            "image": { "label": "Base image" },
            "prompt": { "label": "Motion prompt" }
          },
          "outputPorts": {
            "video": { "label": "Generated video" },
            "videos": {
              "label": "Generated videos",
              "description": "One or two video variants generated from the same base image."
            },
            "description": { "label": "Description" }
          },
          "itemActions": {
            "regenerate": { "label": "Regenerate" },
            "replace": { "label": "Replace" },
            "select": { "label": "Select" },
            "download": { "label": "Download" }
          },
          "blockConfigSchema": {
            "properties": {
              "videoVariants": {
                "title": "Video variants",
                "description": "Generate one or two variants from the base image.",
                "options": [
                  { "value": 1, "label": "1 variant" },
                  { "value": 2, "label": "2 variants" }
                ]
              }
            }
          }
        }
      }
    },
    "es": {
      "capabilities": {
        "generate-image-in-browser": {
          "outputPorts": {
            "image": { "label": "Imagen generada" },
            "images": {
              "label": "Imágenes generadas",
              "description": "Todas las variantes nuevas materializadas de esta generación."
            },
            "description": { "label": "Descripción" }
          },
          "itemActions": {
            "regenerate": { "label": "Regenerar" },
            "replace": { "label": "Reemplazar" },
            "select": { "label": "Seleccionar" },
            "download": { "label": "Descargar" }
          },
          "blockConfigSchema": {
            "properties": {
              "aspectRatio": {
                "title": "Proporción",
                "description": "Proporción solicitada para la imagen.",
                "options": [
                  { "value": "16:9", "label": "Horizontal (16:9)" },
                  { "value": "1:1", "label": "Cuadrada (1:1)" },
                  { "value": "9:16", "label": "Vertical (9:16)" }
                ]
              }
            }
          }
        },
        "animate-image-in-browser": {
          "inputPorts": {
            "image": { "label": "Imagen base" },
            "prompt": { "label": "Prompt de movimiento" }
          },
          "outputPorts": {
            "video": { "label": "Vídeo generado" },
            "videos": {
              "label": "Vídeos generados",
              "description": "Una o dos variantes de vídeo generadas desde la misma imagen base."
            },
            "description": { "label": "Descripción" }
          },
          "itemActions": {
            "regenerate": { "label": "Regenerar" },
            "replace": { "label": "Reemplazar" },
            "select": { "label": "Seleccionar" },
            "download": { "label": "Descargar" }
          },
          "blockConfigSchema": {
            "properties": {
              "videoVariants": {
                "title": "Variantes de vídeo",
                "description": "Genera una o dos variantes desde la imagen base.",
                "options": [
                  { "value": 1, "label": "1 variante" },
                  { "value": 2, "label": "2 variantes" }
                ]
              }
            }
          }
        }
      }
    }
  },
  "capabilities": [
    {
      "id": "generate-text-in-browser",
      "operator": "IA",
      "instructionUsage": "required",
      "promptPreview": {
        "template": "INSTRUÇÕES DO BLOCO:\n{{BLOCK_INSTRUCTIONS}}\n\nCONTEXTO DAS ENTRADAS:\n{{CONTEXT_INPUTS}}"
      },
      "blockTypes": ["CRIAR"],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "content",
          "label": "Contexto para geração",
          "acceptedTypes": [
            "text",
            "textarea",
            "number",
            "boolean",
            "list",
            "records",
            "select",
            "multiselect",
            "datetime",
            "url",
            "thumbnail_layout"
          ],
          "required": false,
          "multiple": true
        },
        {
          "key": "attachments",
          "label": "Referências anexas",
          "acceptedTypes": ["image", "file", "files"],
          "required": false,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Texto gerado",
          "producedTypes": ["text", "textarea"],
          "required": true,
          "presentation": {
            "renderer": "text-long"
          }
        },
        {
          "key": "parts",
          "label": "Respostas por etapa",
          "producedTypes": ["list"],
          "required": false,
          "presentation": {
            "renderer": "list"
          }
        }
      ],
      "acceptedInputTypes": [
        "text",
        "textarea",
        "number",
        "boolean",
        "list",
        "records",
        "select",
        "multiselect",
        "datetime",
        "url",
        "thumbnail_layout",
        "image",
        "file",
        "files"
      ],
      "producedOutputTypes": ["text", "textarea", "list"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1,
        "itemOrchestration": {
          "inputPort": "content",
          "outputPort": "parts",
          "combinedOutputPort": "result",
          "separator": "\n\n",
          "mode": "sequential"
        }
      },
      "sideEffects": ["external_write", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Meta AI web"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente para o próximo perfil cadastrado sempre que houver qualquer erro na execução."
          },
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "startMinimized": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          },
          "parts": {
            "type": "array"
          }
        },
        "required": ["result"]
      }
    },
    {
      "id": "generate-image-in-browser",
      "operator": "IA",
      "promptPreview": {
        "template": "INSTRUÇÕES DO BLOCO:\n{{BLOCK_INSTRUCTIONS}}\n\nCONTEXTO DAS ENTRADAS:\n{{CONTEXT_INPUTS}}\n\nPROPORÇÃO DA IMAGEM: {{CONFIG:aspectRatio}}"
      },
      "blockTypes": ["CRIAR"],
      "processTypes": ["thumbnail", "assets"],
      "itemActions": [
        { "action": "regenerate" },
        { "action": "replace" },
        { "action": "select" },
        { "action": "download" }
      ],
      "inputPorts": [
        {
          "key": "prompt",
          "label": "Prompt da imagem",
          "acceptedTypes": ["text", "textarea"],
          "required": true,
          "multiple": true
        },
        {
          "key": "references",
          "label": "Imagens de referência",
          "acceptedTypes": ["image", "file", "files"],
          "required": false,
          "multiple": true,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        }
      ],
      "outputPorts": [
        {
          "key": "image",
          "label": "Imagem gerada",
          "producedTypes": ["image"],
          "required": true,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "images",
          "label": "Imagens geradas",
          "description": "Todas as variantes novas materializadas desta geração.",
          "producedTypes": ["files"],
          "required": false,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "description",
          "label": "Descrição",
          "producedTypes": ["textarea"],
          "required": false
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "image", "file", "files"],
      "producedOutputTypes": ["image", "textarea"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1,
        "itemOrchestration": {
          "inputPort": "prompt",
          "outputPort": "images",
          "mode": "sequential"
        }
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Meta AI / Muse Image web"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente para o próximo perfil cadastrado sempre que houver qualquer erro na execução."
          },
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "startMinimized": {
            "type": "boolean",
            "default": true
          },
          "aspectRatio": {
            "type": "string",
            "title": "Proporção",
            "description": "Proporção solicitada para a imagem.",
            "default": "1:1",
            "oneOf": [
              { "const": "16:9", "title": "Paisagem (16:9)" },
              { "const": "1:1", "title": "Quadrada (1:1)" },
              { "const": "9:16", "title": "Retrato (9:16)" }
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image": {
            "type": "object"
          },
          "images": {
            "type": "array"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["image"]
      },
      "instructionUsage": "required"
    },
    {
      "id": "animate-image-in-browser",
      "operator": "IA",
      "promptPreview": {
        "template": "INSTRUÇÕES DO BLOCO:\n{{BLOCK_INSTRUCTIONS}}\n\nCONTEXTO DAS ENTRADAS:\n{{CONTEXT_INPUTS}}\n\nVARIANTES DE VÍDEO: {{CONFIG:videoVariants}}"
      },
      "blockTypes": ["CRIAR"],
      "processTypes": ["assets", "editing"],
      "itemActions": [
        { "action": "regenerate" },
        { "action": "replace" },
        { "action": "select" },
        { "action": "download" }
      ],
      "inputPorts": [
        {
          "key": "image",
          "label": "Imagem base",
          "acceptedTypes": ["image", "file"],
          "required": true,
          "multiple": false,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "prompt",
          "label": "Prompt de movimento",
          "acceptedTypes": ["text", "textarea"],
          "required": true,
          "multiple": false
        }
      ],
      "outputPorts": [
        {
          "key": "video",
          "label": "Vídeo gerado",
          "producedTypes": ["video"],
          "required": true
        },
        {
          "key": "videos",
          "label": "Vídeos gerados",
          "description": "Uma ou duas variantes de vídeo geradas a partir da mesma imagem base.",
          "producedTypes": ["files"],
          "required": false
        },
        {
          "key": "description",
          "label": "Descrição",
          "producedTypes": ["textarea"],
          "required": false
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "image", "file"],
      "producedOutputTypes": ["video", "files", "textarea"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 3600000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Meta AI / Vibes web"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente para o próximo perfil cadastrado sempre que houver qualquer erro na execução."
          },
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "startMinimized": {
            "type": "boolean",
            "default": true
          },
          "videoVariants": {
            "type": "integer",
            "title": "Variantes de vídeo",
            "description": "Gera uma ou duas variantes a partir da imagem base.",
            "default": 1,
            "oneOf": [
              { "const": 1, "title": "1 variante" },
              { "const": 2, "title": "2 variantes" }
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "video": { "type": "object" },
          "videos": { "type": "array" },
          "description": { "type": "string" }
        },
        "required": ["video"]
      },
      "instructionUsage": "required"
    },
    {
      "id": "generate-video-in-browser",
      "operator": "IA",
      "blockTypes": ["CRIAR"],
      "processTypes": ["assets", "editing"],
      "itemActions": [
        { "action": "regenerate" },
        { "action": "replace" },
        { "action": "select" },
        { "action": "download" }
      ],
      "inputPorts": [
        {
          "key": "prompt",
          "label": "Prompt do vídeo",
          "acceptedTypes": ["text", "textarea"],
          "required": true,
          "multiple": true
        },
        {
          "key": "references",
          "label": "Imagem ou vídeo de referência",
          "acceptedTypes": ["image", "video", "file", "files"],
          "required": false,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "video",
          "label": "Vídeo gerado",
          "producedTypes": ["video"],
          "required": true
        },
        {
          "key": "description",
          "label": "Descrição",
          "producedTypes": ["textarea"],
          "required": false
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "image", "video", "file", "files"],
      "producedOutputTypes": ["video", "textarea"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 3600000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Meta AI / Vibes web"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente para o próximo perfil cadastrado sempre que houver qualquer erro na execução."
          },
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "startMinimized": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "video": {
            "type": "object"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["video"]
      },
      "instructionUsage": "required"
    }
  ]
}
