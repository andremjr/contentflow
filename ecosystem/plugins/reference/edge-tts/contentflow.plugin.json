{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v2.schema.json",
  "apiVersion": "2",
  "id": "official-edge-tts",
  "name": "Microsoft Edge TTS",
  "version": "2.0.1",
  "description": "Gera narração MP3 com as vozes online gratuitas usadas pelo recurso Ler em voz alta do Microsoft Edge.",
  "author": "ContentFlow",
  "license": "MIT",
  "branding": {
    "iconPath": "assets/icon.png"
  },
  "homepage": "https://github.com/andremjr/contentflow",
  "repository": "https://github.com/andremjr/plugins-contentflow",
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "1.3.3",
  "entrypoint": "handler.mjs",
  "permissions": [
    "network",
    "filesystem:read",
    "filesystem:write",
    "process"
  ],
  "networkHosts": [
    "speech.platform.bing.com"
  ],
  "capabilities": [
    {
      "id": "text-to-speech",
      "operator": "Código",
      "blockTypes": [
        "CRIAR"
      ],
      "processTypes": [
        "narration"
      ],
      "inputPorts": [
        {
          "key": "text",
          "label": "Texto da narração",
          "description": "Texto enviado ao serviço online de leitura do Microsoft Edge.",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        }
      ],
      "outputPorts": [
        {
          "key": "audio",
          "label": "Narração Edge TTS",
          "description": "Arquivo MP3 mono gerado pelo serviço do Microsoft Edge.",
          "required": true,
          "presentation": {
            "renderer": "audio-player"
          },
          "shape": {
            "kind": "content",
            "family": "audio",
            "cardinality": "one",
            "representation": "artifact",
            "formats": {
              "mimeTypes": [
                "audio/mpeg"
              ]
            }
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 120000,
        "supportsCancellation": false,
        "maxConcurrency": 1
      },
      "sideEffects": [
        "external_write",
        "local_artifact",
        "subprocess"
      ],
      "cost": {
        "model": "free",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": [
          "Microsoft Edge online TTS"
        ]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voice": {
            "type": "string",
            "title": "Voz",
            "description": "ShortName de uma voz neural disponível no Edge TTS.",
            "pattern": "^[a-z]{2,3}-[A-Z]{2}-[A-Za-z0-9]+Neural$",
            "default": "en-US-GuyNeural"
          },
          "ratePercent": {
            "type": "integer",
            "title": "Velocidade (%)",
            "minimum": -50,
            "maximum": 100,
            "default": 0
          },
          "volumePercent": {
            "type": "integer",
            "title": "Volume (%)",
            "minimum": -50,
            "maximum": 100,
            "default": 0
          },
          "pitchHz": {
            "type": "integer",
            "title": "Tom (Hz)",
            "minimum": -100,
            "maximum": 100,
            "default": 0
          }
        },
        "required": [
          "voice",
          "ratePercent",
          "volumePercent",
          "pitchHz"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "pattern": "\\.mp3$"
              },
              "mimeType": {
                "const": "audio/mpeg"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string",
                "pattern": "^artifact://"
              }
            },
            "required": [
              "id",
              "name",
              "mimeType",
              "size",
              "url"
            ]
          }
        },
        "required": [
          "audio"
        ]
      }
    }
  ]
}
