{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v2.schema.json",
  "apiVersion": "2",
  "id": "local.contentflow.chatgpt-browser-studio",
  "name": "ChatGPT Browser Studio",
  "version": "2.0.2",
  "description": "Automação modular do ChatGPT web para criar, pesquisar, escolher, validar, analisar arquivos e gerar imagens.",
  "localizations": {
    "en": {
      "description": "Modular ChatGPT web automation for creating, researching, choosing, validating, analyzing files, and generating images.",
      "profileSetup": {
        "label": "Save profile",
        "description": "Opens ChatGPT for sign-in and closes Chrome after validating the chat area."
      },
      "capabilities": {
        "generate-image-in-browser": {
          "name": "Generate images",
          "description": "Generates one or more images in ChatGPT and imports every new valid variant.",
          "inputPorts": {
            "prompt": {
              "label": "Image prompt"
            },
            "references": {
              "label": "Reference images"
            },
            "prompts": {
              "label": "Image prompts"
            }
          },
          "outputPorts": {
            "image": {
              "label": "Generated image"
            },
            "images": {
              "label": "Generated images"
            },
            "description": {
              "label": "Generation description"
            }
          },
          "itemActions": {
            "regenerate": {
              "label": "Regenerate"
            },
            "replace": {
              "label": "Replace"
            },
            "select": {
              "label": "Select"
            },
            "download": {
              "label": "Download"
            }
          },
          "blockConfigSchema": {
            "properties": {
              "fallbackAccountProfiles": {
                "title": "Fallback profiles",
                "description": "Additional aliases, one per line, in order. The system automatically advances to the next saved profile whenever execution fails."
              },
              "accountProfile": {
                "title": "Account profile"
              },
              "startMinimized": {
                "title": "Start minimized"
              }
            }
          }
        },
        "generate-text-in-browser": {
          "blockConfigSchema": {
            "properties": {
              "textItemFormat": {
                "title": "Text item format",
                "options": [
                  {
                    "value": "plain",
                    "label": "Plain text"
                  },
                  {
                    "value": "json",
                    "label": "Structured JSON text"
                  }
                ]
              },
              "textItemFields": {
                "title": "JSON text fields"
              },
              "textItemReferenceInputs": {
                "title": "Inputs supplying IDs"
              }
            }
          },
          "inputPorts": {
            "context_items": {
              "label": "Reference text items"
            }
          }
        }
      }
    },
    "es": {
      "description": "Automatización modular de ChatGPT web para crear, investigar, elegir, validar, analizar archivos y generar imágenes.",
      "profileSetup": {
        "label": "Guardar perfil",
        "description": "Abre ChatGPT para iniciar sesión y cierra Chrome después de validar el área del chat."
      },
      "capabilities": {
        "generate-image-in-browser": {
          "name": "Generar imágenes",
          "description": "Genera una o más imágenes en ChatGPT e importa cada variante nueva válida.",
          "inputPorts": {
            "prompt": {
              "label": "Prompt de la imagen"
            },
            "references": {
              "label": "Imágenes de referencia"
            },
            "prompts": {
              "label": "Prompts de imagen"
            }
          },
          "outputPorts": {
            "image": {
              "label": "Imagen generada"
            },
            "images": {
              "label": "Imágenes generadas"
            },
            "description": {
              "label": "Descripción de la generación"
            }
          },
          "itemActions": {
            "regenerate": {
              "label": "Regenerar"
            },
            "replace": {
              "label": "Reemplazar"
            },
            "select": {
              "label": "Seleccionar"
            },
            "download": {
              "label": "Descargar"
            }
          },
          "blockConfigSchema": {
            "properties": {
              "fallbackAccountProfiles": {
                "title": "Perfiles alternativos",
                "description": "Aliases adicionales, uno por línea y en orden. El sistema avanza automáticamente al siguiente perfil guardado cuando falla la ejecución."
              },
              "accountProfile": {
                "title": "Perfil de la cuenta"
              },
              "startMinimized": {
                "title": "Iniciar minimizado"
              }
            }
          }
        },
        "generate-text-in-browser": {
          "blockConfigSchema": {
            "properties": {
              "textItemFormat": {
                "title": "Formato de cada texto",
                "options": [
                  {
                    "value": "plain",
                    "label": "Texto directo"
                  },
                  {
                    "value": "json",
                    "label": "Texto JSON estructurado"
                  }
                ]
              },
              "textItemFields": {
                "title": "Campos del texto JSON"
              },
              "textItemReferenceInputs": {
                "title": "Entradas que proporcionan IDs"
              }
            }
          },
          "inputPorts": {
            "context_items": {
              "label": "Lista de textos de referencia"
            }
          }
        }
      }
    }
  },
  "author": "André Marinho Jr.",
  "license": "MIT",
  "branding": {
    "iconPath": "assets/icon.png"
  },
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "1.3.3",
  "entrypoint": "handler.mjs",
  "browserRuntime": {
    "lifecycle": "core"
  },
  "permissions": [
    "network",
    "filesystem:read",
    "filesystem:write",
    "process"
  ],
  "networkHosts": [
    "chatgpt.com",
    "files.oaiusercontent.com"
  ],
  "supportsConversationContinuation": true,
  "profileSetup": {
    "configurationKey": "accountProfile",
    "fallbackConfigurationKey": "fallbackAccountProfiles",
    "label": "Salvar perfil",
    "description": "Abre o ChatGPT para login e fecha o Chrome após validar a área do chat."
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chromeExecutable": {
        "type": "string",
        "default": "",
        "description": "Caminho opcional do Google Chrome."
      },
      "profilesBasePath": {
        "type": "string",
        "default": "",
        "description": "Pasta-base opcional dos perfis ChatGPT. Vazio usa o workspace autorizado do plugin."
      },
      "allowExistingChromeProfile": {
        "type": "boolean",
        "default": false,
        "description": "Permite usar uma pasta de perfil Chrome existente escolhida explicitamente. Feche outras instâncias que estejam usando o mesmo perfil."
      },
      "remoteDebuggingPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 64000,
        "default": 9544
      },
      "keepBrowserOpen": {
        "type": "boolean",
        "default": true
      },
      "startMinimized": {
        "type": "boolean",
        "default": true
      },
      "interactiveWaitSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 600
      },
      "responseTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 3600,
        "default": 1200
      },
      "typingChunkSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 10
      },
      "typingDelayMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200,
        "default": 10
      },
      "diagnosticTrace": {
        "type": "boolean",
        "default": false,
        "description": "Registra apenas etapas e tamanhos redigidos."
      },
      "diagnosticMockResponse": {
        "type": "string",
        "default": "",
        "description": "Somente para testes locais; não abre navegador."
      }
    }
  },
  "capabilities": [
    {
      "id": "generate-text-in-browser",
      "operator": "IA",
      "instructionUsage": "required",
      "promptPreview": {
        "template": "INSTRUÇÕES DO BLOCO:\n{{BLOCK_INSTRUCTIONS}}\n\nCONTEXTO DAS ENTRADAS:\n{{CONTEXT_INPUTS}}"
      },
      "blockTypes": [
        "CRIAR"
      ],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "content",
          "label": "Contexto para geração",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "many",
            "representation": "inline"
          }
        },
        {
          "key": "history",
          "label": "Histórico do canal",
          "description": "Registros históricos explicitamente vinculados pelo núcleo para orientar a geração.",
          "required": false,
          "shape": {
            "kind": "record",
            "cardinality": "many",
            "fields": [],
            "open": true
          }
        },
        {
          "key": "context_1",
          "label": "Contexto adicional 1",
          "description": "Entrada textual adicional explicitamente vinculada pelo Método e enviada no contexto da instrução.",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "context_2",
          "label": "Contexto adicional 2",
