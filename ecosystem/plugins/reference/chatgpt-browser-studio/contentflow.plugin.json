          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "context_3",
          "label": "Contexto adicional 3",
          "description": "Entrada textual adicional explicitamente vinculada pelo Método e enviada no contexto da instrução.",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "context_4",
          "label": "Contexto adicional 4",
          "description": "Entrada textual adicional explicitamente vinculada pelo Método e enviada no contexto da instrução.",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "context_5",
          "label": "Contexto adicional 5",
          "description": "Entrada textual adicional explicitamente vinculada pelo Método e enviada no contexto da instrução.",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "context_6",
          "label": "Contexto adicional 6",
          "description": "Entrada textual adicional explicitamente vinculada pelo Método e enviada no contexto da instrução.",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "outline",
          "label": "Outline / estrutura",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "many",
            "representation": "inline"
          }
        },
        {
          "key": "attachments",
          "label": "Referências anexas",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "image",
            "cardinality": "many",
            "representation": "artifact"
          }
        },
        {
          "key": "documents",
          "label": "Documentos de contexto",
          "description": "Arquivos de texto, Markdown ou SRT explicitamente anexados ao contexto da geração.",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "many",
            "representation": "artifact",
            "formats": {
              "mimeTypes": [
                "application/x-subrip",
                "text/plain",
                "text/markdown"
              ]
            }
          }
        },
        {
          "key": "context_items",
          "label": "Lista de textos de referência",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "many",
            "representation": "inline"
          }
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Texto gerado",
          "required": true,
          "presentation": {
            "renderer": "text-long"
          },
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "parts",
          "label": "Respostas por etapa",
          "required": false,
          "presentation": {
            "renderer": "list"
          },
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "many",
            "representation": "inline"
          }
        },
        {
          "key": "records",
          "label": "Registros estruturados",
          "description": "Lista de objetos JSON produzida quando o Método declara uma saída estruturada.",
          "required": false,
          "presentation": {
            "renderer": "table"
          },
          "shape": {
            "kind": "record",
            "cardinality": "many",
            "fields": [],
            "open": true
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1,
        "itemOrchestration": {
          "inputPort": "content",
          "outputPort": "parts",
          "combinedOutputPort": "result",
          "separator": "\n\n",
          "mode": "sequential",
          "strategies": [
            "per_item"
          ],
          "preferredStrategy": "per_item"
        }
      },
      "sideEffects": [
        "external_write",
        "subprocess"
      ],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": [
          "OpenAI / ChatGPT web"
        ]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente para o próximo perfil cadastrado sempre que houver qualquer erro na execução."
          },
          "accountProfile": {
            "type": "string",
            "title": "Perfil da conta ChatGPT",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "startMinimized": {
            "type": "boolean",
            "default": true
          },
          "textItemFormat": {
            "type": "string",
            "title": "Formato de cada texto",
            "default": "plain",
            "oneOf": [
              {
                "const": "plain",
                "title": "Texto direto"
              },
              {
                "const": "json",
                "title": "Texto JSON estruturado"
              }
            ],
            "ui": {
              "section": "primary",
              "order": 0
            }
          },
          "textItemFields": {
            "type": "string",
            "title": "Campos do texto JSON",
            "format": "textarea",
            "default": "{\"prompt\":\"string\"}",
            "visibleWhen": {
              "property": "textItemFormat",
              "values": [
                "json"
              ]
            },
            "ui": {
              "section": "advanced"
            }
          },
          "textItemReferenceInputs": {
            "type": "string",
            "title": "Entradas que fornecem IDs",
            "format": "textarea",
            "default": "{}",
            "visibleWhen": {
              "property": "textItemFormat",
              "values": [
                "json"
              ]
            },
            "ui": {
              "section": "advanced"
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "string",
            "minLength": 1
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "result"
        ]
      }
    },
