{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/ecosystem/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "local.contentflow.gemini-browser-studio",
  "name": "Gemini Browser Studio",
  "version": "0.2.3",
  "description": "Automação modular do Gemini web para texto, pesquisa, escolha, validação, análise de arquivos, imagens e música.",
  "author": "André Marinho Jr.",
  "license": "Proprietary",
  "branding": { "iconPath": "assets/icon.png" },
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.3.0",
  "entrypoint": "handler.mjs",
  "permissions": ["network", "filesystem:read", "filesystem:write", "process"],
  "networkHosts": [
    "gemini.google.com",
    "googleusercontent.com",
    "contribution.usercontent.google.com"
  ],
  "deliveryTypes": ["text", "image", "audio", "processing"],
  "profileSetup": {
    "configurationKey": "accountProfile",
    "label": "Salvar perfil",
    "description": "Abre o Gemini para login e fecha o Chrome após validar a área do chat.",
    "fallbackConfigurationKey": "fallbackAccountProfiles"
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chromeExecutable": {
        "type": "string",
        "default": ""
      },
      "profilesBasePath": {
        "type": "string",
        "default": "",
        "description": "Pasta-base opcional. Vazio usa o workspace autorizado do plugin."
      },
      "allowExistingChromeProfile": {
        "type": "boolean",
        "default": false,
        "description": "Permite usar uma pasta de perfil Chrome existente escolhida explicitamente. Feche outras instâncias que estejam usando o mesmo perfil."
      },
      "remoteDebuggingPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 64000,
        "default": 9644
      },
      "keepBrowserOpen": {
        "type": "boolean",
        "default": false
      },
      "startMinimized": {
        "type": "boolean",
        "default": false
      },
      "interactiveWaitSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 600
      },
      "responseTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 3600,
        "default": 600
      },
      "typingChunkSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 10
      },
      "typingDelayMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200,
        "default": 10
      },
      "diagnosticTrace": {
        "type": "boolean",
        "default": false
      },
      "diagnosticMockResponse": {
        "type": "string",
        "default": "",
        "description": "Somente para testes textuais; não abre navegador."
      }
    }
  },
  "capabilities": [
    {
      "id": "generate-text-in-browser",
      "operator": "IA",
      "instructionUsage": "optional",
      "blockTypes": ["CRIAR"],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "content",
          "label": "Contexto",
          "acceptedTypes": [
            "text",
            "textarea",
            "number",
            "boolean",
            "list",
            "records",
            "select",
            "multiselect",
            "datetime",
            "url",
            "thumbnail_layout"
          ],
          "required": false,
          "multiple": true
        },
        {
          "key": "outline",
          "label": "Outline",
          "acceptedTypes": ["records", "list"],
          "required": false,
          "multiple": false
        },
        {
          "key": "attachments",
          "label": "Referências anexas",
          "acceptedTypes": ["image", "file", "files"],
          "required": false,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Texto gerado",
          "producedTypes": ["text", "textarea"],
          "required": true,
          "presentation": {
            "renderer": "text-long"
          }
        },
        {
          "key": "parts",
          "label": "Respostas por etapa",
          "producedTypes": ["list"],
          "required": false,
          "presentation": {
            "renderer": "list"
          }
        }
      ],
      "acceptedInputTypes": [
        "text",
        "textarea",
        "number",
        "boolean",
        "list",
        "records",
        "select",
        "multiselect",
        "datetime",
        "url",
        "thumbnail_layout",
        "image",
        "file",
        "files"
      ],
      "producedOutputTypes": ["text", "textarea", "list"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Google / Gemini web"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O núcleo troca somente após UPSTREAM_UNAVAILABLE, TIMEOUT ou JOB_FAILED; CAPTCHA, autenticação, bloqueio e cota sempre pausam."
          },
          "modelPreference": {
            "type": "string",
            "default": "current",
            "oneOf": [
              {
                "const": "current",
                "title": "Modelo atual da conta"
              },
              {
                "const": "flash_lite",
                "title": "3.5 Flash Lite"
              },
              {
                "const": "flash",
                "title": "3.6 Flash"
              },
              {
                "const": "pro",
                "title": "3.1 Pro"
              },
              {
                "const": "complex",
                "title": "Raciocínio complexo"
              }
            ]
          },
          "promptTemplate": {
            "type": "string",
            "format": "textarea",
            "default": "{{BLOCK_INSTRUCTIONS}}\n\nCONTEXTO:\n{{CONTENT}}\n\nEntregue somente o conteúdo final solicitado."
          },
          "generationMode": {
            "type": "string",
            "default": "single",
            "oneOf": [
              {
                "const": "single",
                "title": "Uma resposta"
              },
              {
                "const": "legacy_script_3_parts",
                "title": "Roteiro legado em 3 partes"
              },
              {
                "const": "outline_sequence",
                "title": "Outline dinâmica"
              },
              {
                "const": "custom_parts",
                "title": "Partes personalizadas"
              }
            ]
          },
          "outlineFirstPromptTemplate": {
            "type": "string",
            "format": "textarea",
            "default": "{{PROMPT_BASE}}\n\nDesenvolva somente o bloco {{BLOCK_NUMBER}}/{{BLOCK_TOTAL}}. Faça a abertura necessária.\n\n{{BLOCK}}"
          },
          "outlineNextPromptTemplate": {
            "type": "string",
            "format": "textarea",
            "default": "Continue de onde parou. Desenvolva somente o bloco {{BLOCK_NUMBER}}/{{BLOCK_TOTAL}}, sem repetir ou antecipar.\n\n{{BLOCK}}"
          },
          "outlineLastPromptTemplate": {
            "type": "string",
            "format": "textarea",
            "default": "Continue de onde parou. Desenvolva o último bloco {{BLOCK_NUMBER}}/{{BLOCK_TOTAL}} e conclua.\n\n{{BLOCK}}"
          },
          "customParts": {
            "type": "string",
            "format": "textarea",
            "default": ""
          },
          "plainTextOnly": {
            "type": "boolean",
            "default": true
          },
          "cleanOutput": {
            "type": "boolean",
            "default": true
          },
          "minCharacters": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 1
          },
          "delayBetweenPartsMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000,
            "default": 2000
          },
          "retryAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "string",
            "minLength": 1
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["result"]
      }
    },
    {
