{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v2.schema.json",
  "apiVersion": "2",
  "id": "local.contentflow.gemini-browser-studio",
  "name": "Gemini Browser Studio",
  "version": "1.0.9",
  "description": "Automação modular do Gemini web para texto, pesquisa, escolha, validação, análise de arquivos, imagens e música.",
  "author": "André Marinho Jr.",
  "license": "Proprietary",
  "branding": {
    "iconPath": "assets/icon.png"
  },
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.3.0",
  "entrypoint": "handler.mjs",
  "browserRuntime": {
    "lifecycle": "core"
  },
  "permissions": [
    "network",
    "filesystem:read",
    "filesystem:write",
    "process"
  ],
  "networkHosts": [
    "gemini.google.com",
    "googleusercontent.com",
    "contribution.usercontent.google.com"
  ],
  "profileSetup": {
    "configurationKey": "accountProfile",
    "fallbackConfigurationKey": "fallbackAccountProfiles",
    "label": "Salvar perfil",
    "description": "Abre o Gemini para login e fecha o Chrome após validar a área do chat."
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chromeExecutable": {
        "type": "string",
        "default": ""
      },
      "profilesBasePath": {
        "type": "string",
        "default": "",
        "description": "Pasta-base opcional. Vazio usa o workspace autorizado do plugin."
      },
      "allowExistingChromeProfile": {
        "type": "boolean",
        "default": false,
        "description": "Permite usar uma pasta de perfil Chrome existente escolhida explicitamente. Feche outras instâncias que estejam usando o mesmo perfil."
      },
      "remoteDebuggingPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 64000,
        "default": 9644
      },
      "keepBrowserOpen": {
        "type": "boolean",
        "default": true
      },
      "startMinimized": {
        "type": "boolean",
        "default": true
      },
      "interactiveWaitSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 600
      },
      "responseTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 3600,
        "default": 600
      },
      "typingChunkSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 10
      },
      "typingDelayMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200,
        "default": 10
      },
      "diagnosticTrace": {
        "type": "boolean",
        "default": false
      },
      "diagnosticMockResponse": {
        "type": "string",
        "default": "",
        "description": "Somente para testes textuais; não abre navegador."
      }
    }
  },
  "capabilities": [
    {
      "id": "generate-text-in-browser",
      "operator": "IA",
      "instructionUsage": "required",
      "promptPreview": {
        "template": "INSTRUÇÕES DO BLOCO:\n{{BLOCK_INSTRUCTIONS}}\n\nCONTEXTO DAS ENTRADAS:\n{{CONTEXT_INPUTS}}"
      },
      "blockTypes": [
        "CRIAR"
      ],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "content",
          "label": "Contexto",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "outline",
          "label": "Outline",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "many",
            "representation": "inline"
          }
        },
        {
          "key": "attachments",
          "label": "Referências anexas",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "image",
            "cardinality": "many",
            "representation": "artifact"
          }
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Texto gerado",
          "required": true,
          "presentation": {
            "renderer": "text-long"
          },
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "parts",
          "label": "Respostas por etapa",
          "required": false,
          "presentation": {
            "renderer": "list"
          },
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "many",
            "representation": "inline"
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1,
        "itemOrchestration": {
          "inputPort": "content",
          "outputPort": "parts",
          "combinedOutputPort": "result",
          "separator": "\n\n",
          "mode": "sequential"
        }
      },
      "sideEffects": [
        "external_write",
        "subprocess"
      ],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": [
          "Google / Gemini web"
        ]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente para o próximo perfil cadastrado sempre que houver qualquer erro na execução."
          },
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "startMinimized": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "string",
            "minLength": 1
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "result"
        ]
      }
    },
