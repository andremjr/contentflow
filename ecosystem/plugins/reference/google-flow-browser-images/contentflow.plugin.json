                "const": "portrait",
                "title": "Retrato (9:16)"
              }
            ]
          },
          "videoReferenceMode": {
            "type": "string",
            "title": "Usar referências como",
            "default": "elements",
            "oneOf": [
              {
                "const": "frames",
                "title": "Frames"
              },
              {
                "const": "elements",
                "title": "Elementos de referência"
              }
            ]
          },
          "videoDurationSeconds": {
            "type": "integer",
            "title": "Duração",
            "default": 8,
            "oneOf": [
              { "const": 4, "title": "4 segundos" },
              { "const": 6, "title": "6 segundos" },
              { "const": 8, "title": "8 segundos" },
              { "const": 10, "title": "10 segundos (somente modelos compatíveis)" }
            ]
          },
          "videoResolution": {
            "type": "string",
            "title": "Resolução do vídeo",
            "default": "flow_current",
            "oneOf": [
              {
                "const": "flow_current",
                "title": "Padrão do Flow"
              },
              {
                "const": "res_720p",
                "title": "720p"
              },
              {
                "const": "res_1080p",
                "title": "1080p"
              }
            ]
          },
          "delayBetweenPromptsMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000,
            "default": 8000
          },
          "retryAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "video": {
            "oneOf": [{ "type": "object" }, { "type": "array", "minItems": 1 }]
          },
          "project_url": { "type": "string" }
        },
        "required": ["video"]
      }
    }
  ]
}
