{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/ecosystem/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "local.contentflow.google-flow-batch-images",
  "name": "Google Flow Browser Images",
  "version": "1.3.3",
  "description": "Gera imagens reais e vídeos no Google Flow com modelos Nano Banana e Veo, proporções configuráveis, animação de imagens, referências visuais e continuidade de projeto.",
  "author": "Local user",
  "license": "MIT",
  "branding": { "iconPath": "assets/icon.png" },
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.3.0",
  "entrypoint": "handler.mjs",
  "permissions": ["network", "filesystem:read", "filesystem:write", "process"],
  "networkHosts": [
    "flow.google.com",
    "labs.google",
    "flow-content.google",
    "aisandbox-pa.googleapis.com"
  ],
  "deliveryTypes": ["image", "video"],
  "profileSetup": {
    "configurationKey": "accountProfile",
    "label": "Adicionar conta",
    "description": "Abre o Chrome dedicado. Instale manualmente a ContentFlow Browser Bridge no perfil e conclua o login do Google Flow.",
    "fallbackConfigurationKey": "fallbackAccountProfiles"
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chromeExecutable": {
        "type": "string",
        "default": "",
        "description": "Override opcional do caminho do Chrome normal. Vazio detecta automaticamente via Registro/where no Windows."
      },
      "profilePath": {
        "type": "string",
        "default": "",
        "description": "Perfil Chrome do accountProfile default. Vazio usa a raiz do workspace autorizado. Não use seu perfil pessoal padrão."
      },
      "profilesRootPath": {
        "type": "string",
        "default": "",
        "description": "Raiz opcional para perfis adicionais. Vazio usa uma subpasta do workspace autorizado por accountProfile."
      },
      "flowUrl": {
        "type": "string",
        "default": "",
        "description": "Opcional. URL de um projeto específico do Google Flow. Vazio reutiliza um projeto aberto/existente ou cria um novo quando necessário."
      },
      "autoCreateProject": {
        "type": "boolean",
        "default": true,
        "description": "Se nenhum projeto estiver disponível, tenta clicar em Novo projeto automaticamente."
      },
      "remoteDebuggingPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65134,
        "default": 9333
      },
      "keepBrowserOpen": {
        "type": "boolean",
        "default": false,
        "description": "Se ativado explicitamente, mantém o Chrome dedicado aberto entre execuções. Por padrão, o navegador fecha somente depois de capturar e salvar todos os artefatos do job."
      },
      "startMinimized": {
        "type": "boolean",
        "default": true,
        "description": "Inicia minimizado por padrão, mas mantém a janela acessível na barra de tarefas. Este plugin nunca usa modo headless."
      },
      "minimizeWhenReady": {
        "type": "boolean",
        "default": false,
        "description": "Depois que login e projeto estiverem prontos, tenta minimizar a janela automaticamente."
      },
      "interactiveWaitSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 600,
        "description": "Tempo para concluir login, reautenticação, CAPTCHA ou seleção de projeto no primeiro uso."
      },
      "requestTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 300
      },
      "promptSelector": {
        "type": "string",
        "default": "",
        "description": "Override opcional do seletor do editor de prompt."
      },
      "generateSelector": {
        "type": "string",
        "default": "",
        "description": "Override opcional do seletor do botão Iniciar geração."
      },
      "diagnosticTrace": {
        "type": "boolean",
        "default": true,
        "description": "Mantém uma trilha CDP redigida durante o job inteiro para diagnosticar comunicação, ações e transições do Google Flow."
      }
    }
  },
  "capabilities": [
    {
      "id": "generate-images-in-browser",
      "operator": "IA",
      "promptPreview": {
        "template": "{{INPUT:prompts}}"
      },
      "blockTypes": ["CRIAR"],
      "processTypes": ["thumbnail", "assets"],
      "inputPorts": [
        {
          "key": "prompts",
          "label": "Prompts",
          "description": "Um prompt ou uma lista de prompts. No primeiro uso, a execução pode aguardar o login no Chrome dedicado antes de gerar.",
          "acceptedTypes": ["text", "textarea", "list"],
          "required": true,
          "multiple": true
        },
        {
          "key": "reference_images",
          "label": "Imagens de referência",
          "description": "Imagens opcionais compartilhadas pela execução para preservar personagem, avatar, produto, cenário ou estilo.",
          "acceptedTypes": ["image", "file", "files"],
          "required": false,
          "multiple": true,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "project_url",
          "label": "URL do projeto",
          "description": "URL opcional de um projeto do Flow para continuar na mesma sala/chat preservando personagens e histórico.",
          "acceptedTypes": ["url"],
          "required": false,
          "multiple": false
        }
      ],
      "outputPorts": [
        {
          "key": "images",
          "label": "Imagens geradas",
          "description": "Imagens geradas no projeto real do Google Flow e importadas pelo ContentFlow.",
          "producedTypes": ["image", "files"],
          "required": true,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "project_url",
          "label": "URL do projeto",
          "description": "URL do projeto ativo no Google Flow para reaproveitar em blocos seguintes do método.",
          "producedTypes": ["text", "url"],
          "required": false
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "list", "image", "file", "files", "url"],
      "producedOutputTypes": ["image", "files", "text", "url"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 86400000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Google Labs / Flow"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "title": "Perfil de conta",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default",
            "description": "Perfil persistente do Chrome dedicado para isolamento de canais."
          },
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente se houver erro."
          },
          "projectMode": {
            "type": "string",
            "title": "Modo do projeto",
            "default": "auto",
            "oneOf": [
              {
                "const": "auto",
                "title": "Automático (novo projeto ou porta de entrada)"
              },
              {
                "const": "new",
                "title": "Sempre criar novo projeto"
              },
              {
                "const": "existing",
                "title": "Usar projeto específico"
              }
            ],
            "description": "Define se o bloco cria um novo projeto no Google Flow ou continua em um projeto existente."
          },
          "projectUrl": {
            "type": "string",
            "title": "URL do projeto (opcional)",
            "default": "",
            "description": "URL de um projeto em https://flow.google.com/project/... Usado quando o modo for 'Usar projeto específico' ou para fixar um projeto manual."
          },
          "imageModel": {
            "type": "string",
            "title": "Modelo de imagem",
            "default": "flow_auto",
            "oneOf": [
              {
                "const": "flow_auto",
                "title": "Automático: Pro → 2 → 2 Lite (recomendado)"
              },
              {
                "const": "nano_banana_2",
                "title": "Nano Banana 2"
              },
              {
                "const": "nano_banana_pro",
                "title": "Nano Banana Pro"
              },
              {
                "const": "nano_banana_2_lite",
                "title": "Nano Banana 2 Lite"
              }
            ],
            "description": "Modelo de geração de imagem selecionado na interface do Google Flow."
          },
          "imageModelLabel": {
            "type": "string",
            "title": "Outro modelo de imagem (rótulo do Flow)",
            "default": "",
            "maxLength": 120,
            "description": "Opcional. Usa exatamente o rótulo visível de um modelo novo do Flow e substitui a seleção predefinida."
          },
          "fallbackOnModelLimit": {
            "type": "boolean",
            "title": "Fallback de modelo",
            "default": true,
            "description": "Se o modelo atingir limite ou indisponibilidade, segue a ordem Nano Banana Pro → Nano Banana 2 → Nano Banana 2 Lite na mesma conta."
          },
          "aspectRatio": {
            "type": "string",
            "title": "Proporção",
            "default": "flow_current",
            "oneOf": [
              {
                "const": "flow_current",
                "title": "Atual do Flow"
              },
              {
                "const": "landscape",
                "title": "Paisagem (16:9)"
              },
              {
                "const": "landscape_4_3",
                "title": "Paisagem (4:3)"
              },
              {
                "const": "portrait",
                "title": "Retrato (9:16)"
              },
              {
                "const": "portrait_3_4",
                "title": "Retrato (3:4)"
              },
              {
                "const": "square",
                "title": "Quadrada (1:1)"
              }
            ]
          },
          "delayBetweenPromptsMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000,
            "default": 6000,
            "description": "Pausa base entre envios para evitar solicitações consecutivas acidentais."
          },
          "maxConcurrentGenerations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 1,
            "description": "Quantidade máxima em geração simultânea."
          },
          "retryAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 1,
            "description": "Novas tentativas para cada prompt que falhar."
          },
          "rateLimitRetryAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8,
            "default": 8,
            "description": "Reenvios do item após rate limit transitório, sempre respeitando a espera indicada pelo provedor."
          },
          "maxReferenceImages": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "default": 10,
            "description": "Máximo de imagens de referência compartilhadas."
          },
          "maxImagesPerPrompt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 1,
            "description": "Quantidade solicitada ao Flow por prompt: x1, x2, x3 ou x4. O plugin confirma essa opção antes de gerar."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "images": {
            "oneOf": [{ "type": "object" }, { "type": "array", "minItems": 1 }]
          },
          "project_url": { "type": "string" }
        },
        "required": ["images"]
      }
    },
    {
      "id": "animate-image-in-browser",
      "operator": "IA",
      "promptPreview": {
        "template": "{{INPUT:prompts}}"
      },
      "blockTypes": ["CRIAR"],
      "processTypes": ["assets", "editing"],
      "inputPorts": [
        {
          "key": "images",
          "label": "Imagem para animar",
          "description": "Imagem base que será animada no Google Flow com o modelo Veo selecionado.",
          "acceptedTypes": ["image", "file", "files"],
          "required": true,
          "multiple": false,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "prompts",
          "label": "Instrução de movimento",
          "description": "Prompt ou instrução opcional para guiar o movimento e a câmera da animação.",
          "acceptedTypes": ["text", "textarea", "list"],
          "required": false,
          "multiple": false
        },
        {
          "key": "project_url",
          "label": "URL do projeto",
          "description": "URL opcional do projeto/chat do Flow onde a imagem já reside.",
          "acceptedTypes": ["url"],
          "required": false,
          "multiple": false
        }
      ],
      "outputPorts": [
        {
          "key": "video",
          "label": "Vídeo animado",
          "description": "Vídeo MP4 gerado no Google Flow a partir da imagem animada.",
          "producedTypes": ["video", "file", "files"],
          "required": true,
          "presentation": {
            "renderer": "video-player",
            "itemType": "video",
            "acceptedMimeTypes": ["video/mp4"]
          }
        },
        {
          "key": "project_url",
          "label": "URL do projeto",
          "description": "URL do projeto ativo no Google Flow para encadear em blocos seguintes.",
          "producedTypes": ["text", "url"],
          "required": false
        }
      ],
      "acceptedInputTypes": ["image", "file", "files", "text", "textarea", "list", "url"],
      "producedOutputTypes": ["video", "file", "files", "text", "url"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 900000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Google Labs / Flow"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "title": "Perfil de conta",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512
          },
          "projectMode": {
            "type": "string",
            "title": "Modo do projeto",
            "default": "auto",
            "oneOf": [
              {
                "const": "auto",
                "title": "Automático (novo projeto ou porta de entrada)"
              },
              {
                "const": "new",
                "title": "Sempre criar novo projeto"
              },
              {
                "const": "existing",
                "title": "Usar projeto específico"
              }
            ],
            "description": "Define se o bloco cria um novo projeto no Google Flow ou continua em um projeto existente."
          },
          "projectUrl": {
            "type": "string",
            "title": "URL do projeto (opcional)",
            "default": "",
            "description": "URL de um projeto em https://flow.google.com/project/... Usado quando o modo for 'Usar projeto específico' ou para fixar um projeto manual."
          },
          "videoModel": {
            "type": "string",
            "title": "Modelo de vídeo",
            "default": "veo_3_1_fast",
            "oneOf": [
              {
                "const": "veo_3_1_quality",
                "title": "Veo 3.1 - Quality"
              },
              {
                "const": "veo_3_1_fast",
                "title": "Veo 3.1 - Fast"
              },
              {
                "const": "veo_3_1_lite",
                "title": "Veo 3.1 - Lite"
              },
              {
                "const": "omni_1_1_flash",
                "title": "Omni 1.1 Flash"
              }
            ],
            "description": "Modelo de geração de vídeo utilizado na animação."
          },
          "videoModelLabel": {
            "type": "string",
            "title": "Outro modelo de vídeo (rótulo do Flow)",
            "default": "",
            "maxLength": 120,
            "description": "Opcional. Usa exatamente o rótulo visível de um modelo novo do Flow e substitui a seleção predefinida."
          },
          "aspectRatio": {
            "type": "string",
            "title": "Proporção do vídeo",
            "default": "flow_current",
            "oneOf": [
              {
                "const": "flow_current",
                "title": "Atual do Flow"
              },
              {
                "const": "landscape",
                "title": "Paisagem (16:9)"
              },
              {
                "const": "portrait",
                "title": "Retrato (9:16)"
              }
            ]
          },
          "videoReferenceMode": {
            "type": "string",
            "title": "Usar imagem como",
            "default": "frames",
            "oneOf": [
              {
                "const": "frames",
                "title": "Frame"
              },
              {
                "const": "elements",
                "title": "Elemento de referência"
              }
            ],
            "description": "Define se a imagem animada entra no vídeo como frame ou como elemento de referência."
          },
          "videoDurationSeconds": {
            "type": "integer",
            "title": "Duração",
            "default": 8,
            "oneOf": [
              { "const": 4, "title": "4 segundos" },
              { "const": 6, "title": "6 segundos" },
              { "const": 8, "title": "8 segundos" },
              { "const": 10, "title": "10 segundos (somente modelos compatíveis)" }
            ]
          },
          "videoResolution": {
            "type": "string",
            "title": "Resolução do vídeo",
            "default": "flow_current",
            "oneOf": [
              {
                "const": "flow_current",
                "title": "Padrão do Flow"
              },
              {
                "const": "res_720p",
                "title": "720p"
              },
              {
                "const": "res_1080p",
                "title": "1080p"
              }
            ]
          },
          "retryAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "video": {
            "oneOf": [{ "type": "object" }, { "type": "array", "minItems": 1 }]
          },
          "project_url": { "type": "string" }
        },
        "required": ["video"]
      }
    },
