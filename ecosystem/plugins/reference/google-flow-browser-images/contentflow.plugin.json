{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/ecosystem/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "local.contentflow.google-flow-batch-images",
  "name": "Google Flow Browser Images",
  "version": "1.3.7",
  "description": "Gera imagens reais e vídeos no Google Flow com modelos Nano Banana e Veo, proporções configuráveis, animação de imagens, referências visuais, continuidade de projeto e produção visual em lote.",
  "author": "Local user",
  "license": "MIT",
  "branding": {
    "iconPath": "assets/icon.png"
  },
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.3.0",
  "entrypoint": "handler.mjs",
  "permissions": ["network", "filesystem:read", "filesystem:write", "process"],
  "networkHosts": [
    "flow.google.com",
    "labs.google",
    "flow-content.google",
    "aisandbox-pa.googleapis.com"
  ],
  "deliveryTypes": ["image", "video"],
  "profileSetup": {
    "configurationKey": "accountProfile",
    "label": "Adicionar conta",
    "description": "Abre o Chrome dedicado. Instale manualmente a ContentFlow Browser Bridge no perfil e conclua o login do Google Flow.",
    "fallbackConfigurationKey": "fallbackAccountProfiles"
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chromeExecutable": {
        "type": "string",
        "default": "",
        "description": "Override opcional do caminho do Chrome normal. Vazio detecta automaticamente via Registro/where no Windows."
      },
      "profilePath": {
        "type": "string",
        "default": "",
        "description": "Perfil Chrome do accountProfile default. Vazio usa a raiz do workspace autorizado. Não use seu perfil pessoal padrão."
      },
      "profilesRootPath": {
        "type": "string",
        "default": "",
        "description": "Raiz opcional para perfis adicionais. Vazio usa uma subpasta do workspace autorizado por accountProfile."
      },
      "flowUrl": {
        "type": "string",
        "default": "",
        "description": "Opcional. URL de um projeto específico do Google Flow. Vazio reutiliza um projeto aberto/existente ou cria um novo quando necessário."
      },
      "autoCreateProject": {
        "type": "boolean",
        "default": true,
        "description": "Se nenhum projeto estiver disponível, tenta clicar em Novo projeto automaticamente."
      },
      "remoteDebuggingPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65134,
        "default": 9333
      },
      "keepBrowserOpen": {
        "type": "boolean",
        "default": false,
        "description": "Se ativado explicitamente, mantém o Chrome dedicado aberto entre execuções. Por padrão, o navegador fecha somente depois de capturar e salvar todos os artefatos do job."
      },
      "startMinimized": {
        "type": "boolean",
        "default": true,
        "description": "Inicia minimizado por padrão, mas mantém a janela acessível na barra de tarefas. Este plugin nunca usa modo headless."
      },
      "minimizeWhenReady": {
        "type": "boolean",
        "default": false,
        "description": "Depois que login e projeto estiverem prontos, tenta minimizar a janela automaticamente."
      },
      "interactiveWaitSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 600,
        "description": "Tempo para concluir login, reautenticação, CAPTCHA ou seleção de projeto no primeiro uso."
      },
      "requestTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 300
      },
      "promptSelector": {
        "type": "string",
        "default": "",
        "description": "Override opcional do seletor do editor de prompt."
      },
      "generateSelector": {
        "type": "string",
        "default": "",
        "description": "Override opcional do seletor do botão Iniciar geração."
      },
      "diagnosticTrace": {
        "type": "boolean",
        "default": true,
        "description": "Mantém uma trilha CDP redigida durante o job inteiro para diagnosticar comunicação, ações e transições do Google Flow."
      }
    }
  },
  "capabilities": [
    {
      "id": "produce-visual-assets-in-browser",
      "name": "Produção visual completa",
      "description": "Cria imagens, vídeos ou uma combinação dos dois a partir dos prompts das cenas.",
      "operator": "IA",
      "promptPreview": { "template": "{{INPUT:prompts}}" },
      "blockTypes": ["CRIAR"],
      "processTypes": ["assets"],
      "inputPorts": [
        {
          "key": "prompts",
          "label": "Prompts das cenas",
          "description": "Lista ordenada de prompts das cenas. Cada prompt gera uma imagem antes de qualquer animação.",
          "acceptedTypes": ["text", "textarea", "list"],
          "required": true,
          "multiple": true
        },
        {
          "key": "character_prompts",
          "label": "Prompts de personagens",
          "description": "Lista opcional para criar referências visuais antes das cenas. As referências geradas são anexadas a toda a produção para manter a consistência.",
          "acceptedTypes": ["text", "textarea", "list"],
          "required": false,
          "multiple": true
        },
        {
          "key": "animation_prompts",
          "label": "Prompts de animação",
          "description": "Lista opcional, na mesma ordem das cenas, para descrever movimento e câmera. Sem esta entrada, o prompt da própria cena é reutilizado.",
          "acceptedTypes": ["text", "textarea", "list"],
          "required": false,
          "multiple": true
        },
        {
          "key": "reference_images",
          "label": "Referências de personagem e estilo",
          "description": "Imagens reutilizadas em toda a fila para manter personagem, produto, cenário e direção de arte consistentes.",
          "acceptedTypes": ["image", "file", "files"],
          "required": false,
          "multiple": true,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "project_url",
          "label": "URL do projeto",
          "description": "Projeto do Google Flow opcional para preservar a sala, as referências e o histórico.",
          "acceptedTypes": ["url"],
          "required": false,
          "multiple": false
        }
      ],
      "outputPorts": [
        {
          "key": "images",
          "label": "Imagens finais",
          "description": "Imagens preservadas pela política de retenção configurada.",
          "producedTypes": ["files"],
          "required": false,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "character_references",
          "label": "Referências de personagem",
          "description": "Referências geradas no início da produção, quando a opção de salvamento estiver ativada.",
          "producedTypes": ["files"],
          "required": false,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "videos",
          "label": "Vídeos finais",
          "description": "Vídeos animados a partir das imagens selecionadas.",
          "producedTypes": ["files"],
          "required": false,
          "presentation": {
            "renderer": "video-player",
            "itemType": "video",
            "acceptedMimeTypes": ["video/mp4"]
          }
        },
        {
          "key": "project_url",
          "label": "URL do projeto",
          "producedTypes": ["text", "url"],
          "required": false
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "list", "image", "file", "files", "url"],
      "producedOutputTypes": ["files", "text", "url"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 86400000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": { "model": "unknown", "estimateSupported": false },
      "dataPolicy": { "sendsDataToThirdParties": true, "providers": ["Google Labs / Flow"] },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "title": "Perfil de conta",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "productionMode": {
            "type": "string",
            "title": "O que este bloco deve produzir?",
            "description": "Escolha o fluxo visual antes de ajustar detalhes técnicos.",
            "default": "images_only",
            "oneOf": [
              { "const": "images_only", "title": "Somente imagens" },
              { "const": "text_to_video", "title": "Texto direto para vídeo" },
              {
                "const": "images_then_selected_videos",
                "title": "Imagens e animar apenas algumas"
              },
              { "const": "images_to_video_all", "title": "Imagens e animar todas" }
            ]
          },
          "enableCharacterConsistency": {
            "type": "boolean",
            "title": "Manter personagem consistente",
            "description": "Gera referências visuais antes das cenas e as anexa à produção inteira.",
            "default": false,
            "visibleWhen": {
              "property": "productionMode",
              "values": ["images_only", "images_then_selected_videos", "images_to_video_all"]
            }
          },
          "characterPrompts": {
            "type": "string",
            "title": "Prompts de personagem",
            "description": "Um prompt por linha para criar as referências visuais antes das cenas.",
            "format": "textarea",
            "default": "",
            "maxLength": 12000,
            "visibleWhen": { "property": "enableCharacterConsistency", "values": [true] }
          },
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem de uso."
          },
          "projectMode": {
            "type": "string",
            "title": "Modo do projeto",
            "default": "auto",
            "oneOf": [
              { "const": "auto", "title": "Automático" },
              { "const": "new", "title": "Sempre criar novo projeto" },
              { "const": "existing", "title": "Usar projeto específico" }
            ]
          },
          "projectUrl": { "type": "string", "title": "URL do projeto", "default": "" },
          "imageModel": {
            "type": "string",
            "title": "Modelo de imagem",
            "default": "flow_auto",
            "oneOf": [
              { "const": "flow_auto", "title": "Automático: Pro → 2 → 2 Lite" },
              { "const": "nano_banana_2", "title": "Nano Banana 2" },
              { "const": "nano_banana_pro", "title": "Nano Banana Pro" },
              { "const": "nano_banana_2_lite", "title": "Nano Banana 2 Lite" }
            ]
          },
          "imageModelLabel": {
            "type": "string",
            "title": "Outro modelo de imagem",
            "default": "",
            "maxLength": 120
          },
          "fallbackOnModelLimit": {
            "type": "boolean",
            "title": "Usar fallback ao atingir limite de imagem",
            "default": true
          },
          "aspectRatio": {
            "type": "string",
            "title": "Proporção",
            "default": "flow_current",
            "oneOf": [
              { "const": "flow_current", "title": "Atual do Flow" },
              { "const": "landscape", "title": "Paisagem (16:9)" },
              { "const": "portrait", "title": "Retrato (9:16)" },
              { "const": "square", "title": "Quadrada (1:1)" }
            ]
          },
          "maxImagesPerPrompt": {
            "type": "integer",
            "title": "Imagens por prompt",
            "minimum": 1,
            "maximum": 4,
            "default": 1
          },
          "maxConcurrentGenerations": {
            "type": "integer",
            "title": "Gerações de imagem simultâneas",
            "minimum": 1,
            "maximum": 3,
            "default": 1
          },
          "maxReferenceImages": {
            "type": "integer",
            "title": "Máximo de referências",
            "minimum": 0,
            "maximum": 10,
            "default": 10
          },
          "maxCharacterReferences": {
            "type": "integer",
            "title": "Referências de personagem a usar",
            "description": "Limita quantas imagens geradas pelos prompts de personagem entram como referência nas cenas.",
            "minimum": 1,
            "maximum": 10,
            "default": 1
          },
          "saveCharacterReferences": {
            "type": "boolean",
            "title": "Salvar referências de personagem na entrega final",
            "default": true
          },
          "maxVideosToAnimate": {
            "type": "integer",
            "title": "Quantas imagens animar",
            "description": "Escolha um limite compatível com os créditos da conta.",
            "minimum": 1,
            "maximum": 300,
            "default": 3,
            "visibleWhen": {
              "property": "productionMode",
              "values": ["images_then_selected_videos"]
            }
          },
          "animationSelection": {
            "type": "string",
            "title": "Critério para escolher imagens",
            "default": "first",
            "oneOf": [
              { "const": "first", "title": "Primeiras da fila" },
              { "const": "last", "title": "Últimas da fila" },
              { "const": "evenly_spaced", "title": "Distribuídas pela fila" },
              { "const": "manual_indexes", "title": "Índices informados manualmente" }
            ],
            "visibleWhen": {
              "property": "productionMode",
              "values": ["images_then_selected_videos"]
            }
          },
          "animationIndexes": {
            "type": "string",
            "title": "Índices para animar",
            "format": "textarea",
            "default": "",
            "maxLength": 2048,
            "description": "Usado no critério manual. Informe posições 1-baseadas: 1, 7, 10-14.",
            "visibleWhen": {
              "property": "productionMode",
              "values": ["images_then_selected_videos"]
            }
          },
          "imageRetention": {
            "type": "string",
            "title": "Salvar imagens na entrega final",
            "default": "keep_all",
            "oneOf": [
              { "const": "keep_all", "title": "Todas as imagens" },
              { "const": "keep_animated_only", "title": "Somente as imagens animadas" },
              { "const": "omit_from_final_delivery", "title": "Não salvar imagens finais" }
            ],
            "visibleWhen": {
              "property": "productionMode",
              "values": ["images_only", "images_then_selected_videos", "images_to_video_all"]
            }
          },
          "videoModel": {
            "type": "string",
            "title": "Modelo de vídeo",
            "default": "veo_3_1_fast",
            "oneOf": [
              { "const": "veo_3_1_quality", "title": "Veo 3.1 - Quality" },
              { "const": "veo_3_1_fast", "title": "Veo 3.1 - Fast" },
              { "const": "veo_3_1_lite", "title": "Veo 3.1 - Lite" },
              { "const": "omni_1_1_flash", "title": "Omni 1.1 Flash" }
            ],
            "visibleWhen": {
              "property": "productionMode",
              "values": ["text_to_video", "images_then_selected_videos", "images_to_video_all"]
            }
          },
          "videoModelLabel": {
            "type": "string",
            "title": "Outro modelo de vídeo",
            "default": "",
            "maxLength": 120,
            "visibleWhen": {
              "property": "productionMode",
              "values": ["text_to_video", "images_then_selected_videos", "images_to_video_all"]
            }
          },
          "videoReferenceMode": {
            "type": "string",
            "title": "Usar imagem no vídeo como",
            "default": "frames",
            "oneOf": [
              { "const": "frames", "title": "Frame" },
              { "const": "elements", "title": "Elemento de referência" }
            ],
            "visibleWhen": {
              "property": "productionMode",
              "values": ["images_then_selected_videos", "images_to_video_all"]
            }
          },
          "videoDurationSeconds": {
            "type": "integer",
            "title": "Duração do vídeo",
            "default": 8,
            "oneOf": [
              { "const": 4, "title": "4 segundos" },
              { "const": 6, "title": "6 segundos" },
              { "const": 8, "title": "8 segundos" },
              { "const": 10, "title": "10 segundos" }
            ],
            "visibleWhen": {
              "property": "productionMode",
              "values": ["text_to_video", "images_then_selected_videos", "images_to_video_all"]
            }
          },
          "videoResolution": {
            "type": "string",
            "title": "Resolução do vídeo",
            "default": "flow_current",
            "oneOf": [
              { "const": "flow_current", "title": "Padrão do Flow" },
              { "const": "res_720p", "title": "720p" },
              { "const": "res_1080p", "title": "1080p" }
            ],
            "visibleWhen": {
              "property": "productionMode",
              "values": ["text_to_video", "images_then_selected_videos", "images_to_video_all"]
            }
          },
          "delayBetweenPromptsMs": {
            "type": "integer",
            "title": "Pausa entre prompts (ms)",
            "minimum": 0,
            "maximum": 30000,
            "default": 6000
          },
          "retryAttempts": {
            "type": "integer",
            "title": "Tentativas por item",
            "minimum": 0,
            "maximum": 2,
            "default": 1
          },
          "startMinimized": {
            "type": "boolean",
            "title": "Iniciar Chrome minimizado",
            "default": true
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "images": { "type": "array" },
          "character_references": { "type": "array" },
          "videos": { "type": "array" },
          "project_url": { "type": "string" }
        }
      }
    },
    {
      "id": "generate-images-in-browser",
      "name": "Gerar imagens",
      "description": "Cria uma ou mais imagens para cada prompt no Google Flow.",
      "operator": "IA",
      "promptPreview": {
        "template": "{{INPUT:prompts}}"
      },
      "blockTypes": ["CRIAR"],
      "processTypes": ["thumbnail", "assets"],
      "inputPorts": [
        {
          "key": "prompts",
          "label": "Prompts",
          "description": "Um prompt ou uma lista de prompts. No primeiro uso, a execução pode aguardar o login no Chrome dedicado antes de gerar.",
          "acceptedTypes": ["text", "textarea", "list"],
          "required": true,
          "multiple": true
        },
        {
          "key": "reference_images",
          "label": "Imagens de referência",
          "description": "Imagens opcionais compartilhadas pela execução para preservar personagem, avatar, produto, cenário ou estilo.",
          "acceptedTypes": ["image", "file", "files"],
          "required": false,
          "multiple": true,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "project_url",
          "label": "URL do projeto",
          "description": "URL opcional de um projeto do Flow para continuar na mesma sala/chat preservando personagens e histórico.",
          "acceptedTypes": ["url"],
          "required": false,
          "multiple": false
        }
      ],
      "outputPorts": [
        {
          "key": "images",
          "label": "Imagens geradas",
          "description": "Imagens geradas no projeto real do Google Flow e importadas pelo ContentFlow.",
          "producedTypes": ["image", "files"],
          "required": true,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "project_url",
          "label": "URL do projeto",
          "description": "URL do projeto ativo no Google Flow para reaproveitar em blocos seguintes do método.",
          "producedTypes": ["text", "url"],
          "required": false
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "list", "image", "file", "files", "url"],
      "producedOutputTypes": ["image", "files", "text", "url"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 86400000,
        "supportsCancellation": true,
        "maxConcurrency": 1,
        "itemOrchestration": {
          "mode": "sequential",
          "inputPort": "prompts",
          "outputPort": "images"
        }
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Google Labs / Flow"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "title": "Perfil de conta",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default",
            "description": "Perfil persistente do Chrome dedicado para isolamento de canais."
          },
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente se houver erro."
          },
          "projectMode": {
            "type": "string",
            "title": "Modo do projeto",
            "default": "auto",
            "oneOf": [
              {
                "const": "auto",
                "title": "Automático (novo projeto ou porta de entrada)"
              },
              {
                "const": "new",
                "title": "Sempre criar novo projeto"
              },
              {
                "const": "existing",
                "title": "Usar projeto específico"
              }
            ],
            "description": "Define se o bloco cria um novo projeto no Google Flow ou continua em um projeto existente."
          },
          "projectUrl": {
            "type": "string",
            "title": "URL do projeto (opcional)",
            "default": "",
            "description": "URL de um projeto em https://flow.google.com/project/... Usado quando o modo for 'Usar projeto específico' ou para fixar um projeto manual."
          },
          "imageModel": {
            "type": "string",
            "title": "Modelo de imagem",
            "default": "flow_auto",
            "oneOf": [
              {
                "const": "flow_auto",
                "title": "Automático: Pro → 2 → 2 Lite (recomendado)"
              },
              {
                "const": "nano_banana_2",
                "title": "Nano Banana 2"
              },
              {
                "const": "nano_banana_pro",
                "title": "Nano Banana Pro"
              },
              {
                "const": "nano_banana_2_lite",
                "title": "Nano Banana 2 Lite"
              }
            ],
            "description": "Modelo de geração de imagem selecionado na interface do Google Flow."
          },
          "imageModelLabel": {
            "type": "string",
            "title": "Outro modelo de imagem (rótulo do Flow)",
            "default": "",
            "maxLength": 120,
            "description": "Opcional. Usa exatamente o rótulo visível de um modelo novo do Flow e substitui a seleção predefinida."
          },
          "fallbackOnModelLimit": {
            "type": "boolean",
            "title": "Fallback de modelo",
            "default": true,
            "description": "Se o modelo atingir limite ou indisponibilidade, segue a ordem Nano Banana Pro → Nano Banana 2 → Nano Banana 2 Lite na mesma conta."
          },
          "aspectRatio": {
            "type": "string",
            "title": "Proporção",
            "default": "flow_current",
            "oneOf": [
              {
                "const": "flow_current",
                "title": "Atual do Flow"
              },
              {
                "const": "landscape",
                "title": "Paisagem (16:9)"
              },
              {
                "const": "landscape_4_3",
                "title": "Paisagem (4:3)"
              },
              {
                "const": "portrait",
                "title": "Retrato (9:16)"
