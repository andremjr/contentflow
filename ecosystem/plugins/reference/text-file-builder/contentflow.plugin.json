{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/ecosystem/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "local.contentflow.text-file-builder",
  "name": "Construtor de Arquivo de Texto",
  "version": "1.0.0",
  "description": "Consolida textos, listas e registros de blocos anteriores em um arquivo Markdown ou TXT reutilizável como anexo.",
  "author": "ContentFlow",
  "license": "LicenseRef-ContentFlow-Source-Available-1.0",
  "homepage": "https://github.com/andremjr/contentflow",
  "repository": "https://github.com/andremjr/contentflow",
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.3.0",
  "entrypoint": "handler.mjs",
  "permissions": ["filesystem:write"],
  "deliveryTypes": ["text"],
  "capabilities": [
    {
      "id": "build-text-file",
      "operator": "Código",
      "instructionUsage": "optional",
      "blockTypes": ["CRIAR"],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "content",
          "label": "Conteúdo do arquivo",
          "description": "Uma ou mais entradas, preservadas com seus rótulos quando o bloco recebe múltiplas fontes.",
          "required": true,
          "acceptedTypes": [
            "text",
            "textarea",
            "number",
            "boolean",
            "list",
            "records",
            "select",
            "multiselect",
            "datetime",
            "url",
            "thumbnail_layout"
          ],
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "document",
          "label": "Arquivo de texto",
          "required": true,
          "presentation": {
            "renderer": "file-list",
            "itemType": "file",
            "acceptedMimeTypes": ["text/markdown", "text/plain"]
          },
          "producedTypes": ["file"]
        }
      ],
      "acceptedInputTypes": [
        "text",
        "textarea",
        "number",
        "boolean",
        "list",
        "records",
        "select",
        "multiselect",
        "datetime",
        "url",
        "thumbnail_layout"
      ],
      "producedOutputTypes": ["file"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 30000,
        "supportsCancellation": false,
        "maxConcurrency": 4
      },
      "sideEffects": ["local_artifact"],
      "cost": {
        "model": "free",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": false
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fileName": {
            "type": "string",
            "title": "Nome do arquivo",
            "default": "contexto.md",
            "maxLength": 120
          },
          "format": {
            "type": "string",
            "title": "Formato",
            "enum": ["markdown", "plain"],
            "default": "markdown"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "mimeType": { "enum": ["text/markdown", "text/plain"] },
              "size": { "type": "integer", "minimum": 1 },
              "url": { "type": "string", "pattern": "^artifact://" }
            },
            "required": ["id", "name", "mimeType", "size", "url"]
          }
        },
        "required": ["document"]
      }
    }
  ]
}
