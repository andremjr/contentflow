{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v2.schema.json",
  "apiVersion": "2",
  "id": "local.contentflow.grok-browser-studio",
  "name": "Grok Browser Studio",
  "version": "2.0.0",
  "description": "Gera texto, pesquisa, imagens e vídeos no Grok web usando um perfil Chrome dedicado, sem API oficial.",
  "author": "André Marinho Jr.",
  "license": "Proprietary",
  "branding": {
    "iconPath": "assets/icon.png"
  },
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "1.3.1",
  "entrypoint": "handler.mjs",
  "browserRuntime": {
    "lifecycle": "core"
  },
  "permissions": [
    "network",
    "filesystem:read",
    "filesystem:write",
    "process"
  ],
  "networkHosts": [
    "grok.com",
    "cdn.grok.com",
    "x.ai",
    "assets.grok.com",
    "imagine-public.x.ai"
  ],
  "profileSetup": {
    "configurationKey": "accountProfile",
    "fallbackConfigurationKey": "fallbackAccountProfiles",
    "label": "Salvar perfil",
    "description": "Abre o Grok Imagine para login e fecha o Chrome depois de validar a área de criação."
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chromeExecutable": {
        "type": "string",
        "default": ""
      },
      "profilesBasePath": {
        "type": "string",
        "default": ""
      },
      "allowExistingChromeProfile": {
        "type": "boolean",
        "default": false,
        "description": "Permite usar uma pasta de perfil Chrome existente escolhida explicitamente. Feche outras instâncias que estejam usando o mesmo perfil."
      },
      "remoteDebuggingPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 64000,
        "default": 9744
      },
      "keepBrowserOpen": {
        "type": "boolean",
        "default": false
      },
      "startMinimized": {
        "type": "boolean",
        "default": true
      },
      "interactiveWaitSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 600
      },
      "responseTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 3600,
        "default": 900
      },
      "typingChunkSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 10
      },
      "typingDelayMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200,
        "default": 10
      },
      "diagnosticTrace": {
        "type": "boolean",
        "default": false
      },
      "diagnosticMockResponse": {
        "type": "string",
        "default": ""
      }
    }
  },
  "capabilities": [
    {
      "id": "generate-text-in-browser",
      "operator": "IA",
      "instructionUsage": "required",
      "promptPreview": {
        "template": "INSTRUÇÕES DO BLOCO:\n{{BLOCK_INSTRUCTIONS}}\n\nCONTEXTO DAS ENTRADAS:\n{{CONTEXT_INPUTS}}"
      },
      "blockTypes": [
        "CRIAR"
      ],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "content",
          "label": "Contexto para geração",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "attachments",
          "label": "Referências anexas",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "image",
            "cardinality": "many",
            "representation": "artifact"
          }
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Texto gerado",
          "required": true,
          "presentation": {
            "renderer": "text-long"
          },
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "parts",
          "label": "Respostas por etapa",
          "required": false,
          "presentation": {
            "renderer": "list"
          },
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "many",
            "representation": "inline"
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1,
        "itemOrchestration": {
          "inputPort": "content",
          "outputPort": "parts",
          "combinedOutputPort": "result",
          "separator": "\n\n",
          "mode": "sequential"
        }
      },
      "sideEffects": [
        "external_write",
        "subprocess"
      ],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": [
          "xAI / Grok web"
        ]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente para o próximo perfil cadastrado sempre que houver qualquer erro na execução."
          },
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "startMinimized": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          },
          "parts": {
            "type": "array"
          }
        },
        "required": [
          "result"
        ]
      }
    },
    {
      "id": "search-web-in-browser",
      "operator": "IA",
      "blockTypes": [
        "BUSCAR"
      ],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "query",
          "label": "Consulta",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "context",
          "label": "Contexto",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Resultado",
          "required": true,
          "presentation": {
            "renderer": "text-long"
          },
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "sources",
          "label": "Fontes",
          "required": false,
          "presentation": {
            "renderer": "list"
          },
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "many",
            "representation": "inline"
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": [
        "external_read",
        "external_write",
        "subprocess"
      ],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": [
          "xAI / Grok web",
          "Fontes públicas"
        ]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente para o próximo perfil cadastrado sempre que houver qualquer erro na execução."
          },
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "startMinimized": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "instructionUsage": "required"
    },
    {
      "id": "generate-image-in-browser",
      "operator": "IA",
      "blockTypes": [
        "CRIAR"
      ],
      "processTypes": [
        "thumbnail",
        "assets"
      ],
      "inputPorts": [
        {
          "key": "prompt",
          "label": "Prompt da imagem",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "references",
          "label": "Imagens de referência",
          "required": false,
          "presentation": {
            "renderer": "image-gallery"
          },
          "shape": {
            "kind": "content",
            "family": "image",
            "cardinality": "many",
            "representation": "artifact",
            "formats": {
              "mimeTypes": [
                "image/*"
              ]
            }
          }
        }
      ],
      "outputPorts": [
        {
          "key": "image",
          "label": "Imagem gerada",
          "required": true,
          "presentation": {
            "renderer": "image-gallery"
          },
          "shape": {
            "kind": "content",
            "family": "image",
            "cardinality": "one",
            "representation": "artifact",
            "formats": {
              "mimeTypes": [
                "image/*"
              ]
            }
          }
        },
        {
          "key": "description",
          "label": "Descrição",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": [
        "external_write",
        "local_artifact",
        "subprocess"
      ],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": [
          "xAI / Grok Imagine web"
        ]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente para o próximo perfil cadastrado sempre que houver qualquer erro na execução."
          },
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "startMinimized": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image": {
            "type": "object"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "image"
        ]
      },
      "instructionUsage": "required"
    },
    {
      "id": "generate-video-in-browser",
      "operator": "IA",
      "blockTypes": [
        "CRIAR"
      ],
      "processTypes": [
        "assets",
        "editing"
      ],
      "inputPorts": [
        {
          "key": "prompt",
          "label": "Prompt do vídeo",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "references",
          "label": "Imagem ou vídeo de referência",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "image",
            "cardinality": "many",
            "representation": "artifact"
          }
        }
      ],
      "outputPorts": [
        {
          "key": "video",
          "label": "Vídeo gerado",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "video",
            "cardinality": "one",
            "representation": "artifact"
          }
        },
        {
          "key": "description",
          "label": "Descrição",
          "required": false,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 3600000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": [
        "external_write",
        "local_artifact",
        "subprocess"
      ],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": [
          "xAI / Grok Imagine web"
        ]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O sistema avança automaticamente para o próximo perfil cadastrado sempre que houver qualquer erro na execução."
          },
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "startMinimized": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "video": {
            "type": "object"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "video"
        ]
      },
      "instructionUsage": "required"
    }
  ]
}
