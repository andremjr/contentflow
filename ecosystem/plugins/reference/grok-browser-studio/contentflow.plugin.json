{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/ecosystem/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "local.contentflow.grok-browser-studio",
  "name": "Grok Browser Studio",
  "version": "0.2.2",
  "description": "Gera texto, pesquisa, imagens e vídeos no Grok web usando um perfil Chrome dedicado, sem API oficial.",
  "author": "André Marinho Jr.",
  "license": "Proprietary",
  "branding": { "iconPath": "assets/icon.png" },
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.3.0",
  "entrypoint": "handler.mjs",
  "permissions": ["network", "filesystem:read", "filesystem:write", "process"],
  "networkHosts": ["grok.com", "cdn.grok.com", "x.ai", "assets.grok.com", "imagine-public.x.ai"],
  "deliveryTypes": ["text", "image", "video", "processing"],
  "profileSetup": {
    "configurationKey": "accountProfile",
    "label": "Salvar perfil",
    "description": "Abre o Grok Imagine para login e fecha o Chrome depois de validar a área de criação.",
    "fallbackConfigurationKey": "fallbackAccountProfiles"
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chromeExecutable": {
        "type": "string",
        "default": ""
      },
      "profilesBasePath": {
        "type": "string",
        "default": ""
      },
      "allowExistingChromeProfile": {
        "type": "boolean",
        "default": false,
        "description": "Permite usar uma pasta de perfil Chrome existente escolhida explicitamente. Feche outras instâncias que estejam usando o mesmo perfil."
      },
      "remoteDebuggingPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 64000,
        "default": 9744
      },
      "keepBrowserOpen": {
        "type": "boolean",
        "default": false
      },
      "startMinimized": {
        "type": "boolean",
        "default": false
      },
      "interactiveWaitSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 600
      },
      "responseTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 3600,
        "default": 900
      },
      "typingChunkSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 10
      },
      "typingDelayMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200,
        "default": 10
      },
      "diagnosticTrace": {
        "type": "boolean",
        "default": false
      },
      "diagnosticMockResponse": {
        "type": "string",
        "default": ""
      }
    }
  },
  "capabilities": [
    {
      "id": "generate-text-in-browser",
      "operator": "IA",
      "instructionUsage": "optional",
      "blockTypes": ["CRIAR"],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "content",
          "label": "Contexto para geração",
          "acceptedTypes": [
            "text",
            "textarea",
            "number",
            "boolean",
            "list",
            "records",
            "select",
            "multiselect",
            "datetime",
            "url",
            "thumbnail_layout"
          ],
          "required": false,
          "multiple": true
        },
        {
          "key": "attachments",
          "label": "Referências anexas",
          "acceptedTypes": ["image", "file", "files"],
          "required": false,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Texto gerado",
          "producedTypes": ["text", "textarea"],
          "required": true,
          "presentation": {
            "renderer": "text-long"
          }
        },
        {
          "key": "parts",
          "label": "Respostas por etapa",
          "producedTypes": ["list"],
          "required": false,
          "presentation": {
            "renderer": "list"
          }
        }
      ],
      "acceptedInputTypes": [
        "text",
        "textarea",
        "number",
        "boolean",
        "list",
        "records",
        "select",
        "multiselect",
        "datetime",
        "url",
        "thumbnail_layout",
        "image",
        "file",
        "files"
      ],
      "producedOutputTypes": ["text", "textarea", "list"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["xAI / Grok web"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O núcleo troca somente após UPSTREAM_UNAVAILABLE, TIMEOUT ou JOB_FAILED; CAPTCHA, autenticação, bloqueio e cota sempre pausam."
          },
          "promptTemplate": {
            "type": "string",
            "format": "textarea",
            "default": "{{BLOCK_INSTRUCTIONS}}\n\nCONTEXTO:\n{{CONTENT}}\n\nEntregue somente o conteúdo final solicitado."
          },
          "generationMode": {
            "type": "string",
            "default": "single",
            "enum": ["single", "legacy_script_3_parts", "outline_sequence", "custom_parts"]
          },
          "customParts": {
            "type": "string",
            "format": "textarea",
            "default": ""
          },
          "reasoningMode": {
            "type": "string",
            "default": "standard",
            "enum": ["standard", "think"]
          },
          "plainTextOnly": {
            "type": "boolean",
            "default": true
          },
          "cleanOutput": {
            "type": "boolean",
            "default": true
          },
          "minCharacters": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 1
          },
          "delayBetweenPartsMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000,
            "default": 2000
          },
          "retryAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          },
          "parts": {
            "type": "array"
          }
        },
        "required": ["result"]
      }
    },
    {
      "id": "search-web-in-browser",
      "operator": "IA",
      "blockTypes": ["BUSCAR"],
      "processTypes": [
        "theme",
        "title",
        "thumbnail",
        "script",
        "narration",
        "assets",
        "editing",
        "publishing"
      ],
      "inputPorts": [
        {
          "key": "query",
          "label": "Consulta",
          "acceptedTypes": ["text", "textarea", "list"],
          "required": true,
          "multiple": true
        },
        {
          "key": "context",
          "label": "Contexto",
          "acceptedTypes": ["text", "textarea", "list", "records", "url"],
          "required": false,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Resultado",
          "producedTypes": ["textarea"],
          "required": true,
          "presentation": {
            "renderer": "text-long"
          }
        },
        {
          "key": "sources",
          "label": "Fontes",
          "producedTypes": ["list"],
          "required": false,
          "presentation": {
            "renderer": "list"
          }
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "list", "records", "url"],
      "producedOutputTypes": ["textarea", "list"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_read", "external_write", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["xAI / Grok web", "Fontes públicas"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O núcleo troca somente após UPSTREAM_UNAVAILABLE, TIMEOUT ou JOB_FAILED; CAPTCHA, autenticação, bloqueio e cota sempre pausam."
          },
          "searchPromptTemplate": {
            "type": "string",
            "format": "textarea",
            "default": "Pesquise a web e responda com informações atuais e fontes.\n\nCONSULTA:\n{{QUERY}}\n\nCONTEXTO:\n{{SEARCH_CONTEXT}}"
          },
          "maxSources": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 10
          },
          "retryAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 1
          }
        }
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "generate-image-in-browser",
      "operator": "IA",
      "blockTypes": ["CRIAR"],
      "processTypes": ["thumbnail", "assets"],
      "inputPorts": [
        {
          "key": "prompt",
          "label": "Prompt da imagem",
          "acceptedTypes": ["text", "textarea"],
          "required": true,
          "multiple": true
        },
        {
          "key": "references",
          "label": "Imagens de referência",
          "acceptedTypes": ["image", "file", "files"],
          "required": false,
          "multiple": true,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        }
      ],
      "outputPorts": [
        {
          "key": "image",
          "label": "Imagem gerada",
          "producedTypes": ["image"],
          "required": true,
          "presentation": {
            "renderer": "image-gallery",
            "itemType": "image",
            "acceptedMimeTypes": ["image/*"]
          }
        },
        {
          "key": "description",
          "label": "Descrição",
          "producedTypes": ["textarea"],
          "required": false
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "image", "file", "files"],
      "producedOutputTypes": ["image", "textarea"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["xAI / Grok Imagine web"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O núcleo troca somente após UPSTREAM_UNAVAILABLE, TIMEOUT ou JOB_FAILED; CAPTCHA, autenticação, bloqueio e cota sempre pausam."
          },
          "imagePromptTemplate": {
            "type": "string",
            "format": "textarea",
            "default": "Crie uma imagem de alta qualidade conforme o briefing.\n\n{{IMAGE_PROMPT}}\n\n{{BLOCK_INSTRUCTIONS}}"
          },
          "retryAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image": {
            "type": "object"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["image"]
      }
    },
    {
      "id": "generate-video-in-browser",
      "operator": "IA",
      "blockTypes": ["CRIAR"],
      "processTypes": ["assets", "editing"],
      "inputPorts": [
        {
          "key": "prompt",
          "label": "Prompt do vídeo",
          "acceptedTypes": ["text", "textarea"],
          "required": true,
          "multiple": true
        },
        {
          "key": "references",
          "label": "Imagem ou vídeo de referência",
          "acceptedTypes": ["image", "video", "file", "files"],
          "required": false,
          "multiple": true
        }
      ],
      "outputPorts": [
        {
          "key": "video",
          "label": "Vídeo gerado",
          "producedTypes": ["video"],
          "required": true
        },
        {
          "key": "description",
          "label": "Descrição",
          "producedTypes": ["textarea"],
          "required": false
        }
      ],
      "acceptedInputTypes": ["text", "textarea", "image", "video", "file", "files"],
      "producedOutputTypes": ["video", "textarea"],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 3600000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["xAI / Grok Imagine web"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem. O núcleo troca somente após UPSTREAM_UNAVAILABLE, TIMEOUT ou JOB_FAILED; CAPTCHA, autenticação, bloqueio e cota sempre pausam."
          },
          "videoPromptTemplate": {
            "type": "string",
            "format": "textarea",
            "default": "Crie um vídeo curto cinematográfico conforme o briefing, com movimento coerente e áudio quando disponível.\n\n{{VIDEO_PROMPT}}\n\n{{BLOCK_INSTRUCTIONS}}"
          },
          "retryAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "video": {
            "type": "object"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["video"]
      }
    }
  ]
}
