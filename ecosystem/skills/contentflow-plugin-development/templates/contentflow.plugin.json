{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/v1.3.1/docs/ecosystem/schemas/contentflow-plugin-v2.schema.json",
  "apiVersion": "2",
  "id": "com.example.contentflow-plugin",
  "name": "Meu plugin ContentFlow",
  "version": "0.1.0",
  "description": "Descreva a entrega observável.",
  "author": "Seu nome ou organização",
  "license": "MIT",
  "runtime": { "kind": "node", "version": ">=26 <27", "module": "esm" },
  "entrypoint": "handler.mjs",
  "permissions": [],
  "capabilities": [
    {
      "id": "transform",
      "operator": "Código",
      "instructionUsage": "not_applicable",
      "blockTypes": ["CRIAR"],
      "inputPorts": [
        {
          "key": "content",
          "label": "Conteúdo",
          "shape": { "kind": "content", "family": "text", "cardinality": "one", "representation": "inline" },
          "required": true
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Resultado",
          "shape": { "kind": "content", "family": "text", "cardinality": "one", "representation": "inline" },
          "required": true
        }
      ],
      "execution": { "mode": "immediate", "maxConcurrency": 1 },
      "sideEffects": [],
      "cost": { "model": "free", "estimateSupported": true },
      "dataPolicy": { "sendsDataToThirdParties": false },
      "blockConfigSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": { "type": "object", "additionalProperties": false }
    }
  ]
}
