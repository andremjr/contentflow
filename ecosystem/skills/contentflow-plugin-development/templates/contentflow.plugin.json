{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/ecosystem/docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "com.example.contentflow-plugin",
  "name": "Meu plugin ContentFlow",
  "version": "0.1.0",
  "description": "Descreva a entrega observável.",
  "author": "Seu nome ou organização",
  "license": "MIT",
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.4.9",
  "entrypoint": "handler.mjs",
  "permissions": [],
  "deliveryTypes": ["text"],
  "capabilities": [
    {
      "id": "transform",
      "operator": "Código",
      "instructionUsage": "not_applicable",
      "blockTypes": ["CRIAR"],
      "inputPorts": [
        {
          "key": "content",
          "label": "Conteúdo",
          "acceptedTypes": ["text", "textarea"],
          "required": true
        }
      ],
      "outputPorts": [
        {
          "key": "result",
          "label": "Resultado",
          "producedTypes": ["text"],
          "required": true
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 60000,
        "supportsCancellation": false,
        "maxConcurrency": 1
      },
      "sideEffects": [],
      "cost": {
        "model": "free",
        "estimateSupported": true
      },
      "dataPolicy": {
        "sendsDataToThirdParties": false
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false
      }
    }
  ]
}
