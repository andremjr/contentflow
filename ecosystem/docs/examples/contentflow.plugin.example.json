{
  "$schema": "../schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "com.exemplo.thumbnail-renderer",
  "name": "Thumbnail Renderer",
  "version": "1.0.0",
  "description": "Renderiza uma thumbnail a partir de um layout 16:9.",
  "author": "Exemplo",
  "license": "MIT",
  "homepage": "https://example.com/contentflow-thumbnail-renderer",
  "repository": "https://github.com/example/contentflow-thumbnail-renderer",
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "0.2.0",
  "entrypoint": "dist/index.js",
  "permissions": ["network", "filesystem:write"],
  "networkHosts": ["api.image-provider.example", "*.image-provider.example"],
  "secretKeys": ["IMAGE_PROVIDER_API_KEY"],
  "deliveryTypes": ["image"],
  "capabilities": [
    {
      "id": "render-thumbnail",
      "operator": "Código",
      "blockTypes": ["CRIAR"],
      "processTypes": ["thumbnail"],
      "inputPorts": [
        {
          "key": "title",
          "label": "Título",
          "acceptedTypes": ["text", "textarea"],
          "required": true
        },
        {
          "key": "layout",
          "label": "Layout",
          "acceptedTypes": ["thumbnail_layout"],
          "required": true
        }
      ],
      "outputPorts": [
        {
          "key": "thumbnail",
          "label": "Thumbnail renderizada",
          "producedTypes": ["image"],
          "required": true
        }
      ],
      "acceptedInputTypes": ["text", "image", "thumbnail_layout"],
      "producedOutputTypes": ["image"],
      "execution": {
        "mode": "async",
        "defaultTimeoutMs": 30000,
        "supportsCancellation": true,
        "maxConcurrency": 2
      },
      "sideEffects": ["external_write", "local_artifact"],
      "cost": {
        "model": "metered",
        "estimateSupported": true
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Example Image Provider"],
        "retentionPolicyUrl": "https://example.com/privacy",
        "trainingPolicyUrl": "https://example.com/ai-data-policy"
      },
      "blockConfigSchema": {
        "type": "object",
        "properties": {
          "quality": {
            "type": "string",
            "enum": ["draft", "final"],
            "default": "final"
          }
        },
        "required": ["quality"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "thumbnail": { "type": "object" }
        },
        "required": ["thumbnail"]
      }
    }
  ]
}
