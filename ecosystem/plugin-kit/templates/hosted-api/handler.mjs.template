export async function execute(request, services) {
  const value = request.inputs["{{INPUT_KEY}}"];
  if (typeof value !== "string") {
    return {
      status: "error",
      code: "INVALID_INPUT",
      message: "{{INPUT_KEY}} precisa ser texto.",
      retryable: false,
    };
  }
  if (typeof request.configuration.mockResponse === "string") {
    return { status: "success", values: { "{{OUTPUT_KEY}}": request.configuration.mockResponse } };
  }
  const token = await services.getSecret("{{SECRET_KEY}}");
  if (!token)
    return {
      status: "error",
      code: "MISSING_SECRET",
      message: "Configure {{SECRET_KEY}}.",
      retryable: false,
    };
  const response = await fetch("https://{{NETWORK_HOST}}/v1/transform", {
    method: "POST",
    headers: { authorization: `Bearer ${token}`, "content-type": "application/json" },
    body: JSON.stringify({ text: value }),
    signal: services.signal,
  });
  if (!response.ok)
    return {
      status: "error",
      code: "REMOTE_ERROR",
      message: `API respondeu ${response.status}.`,
      retryable: response.status >= 500,
    };
  const payload = await response.json();
  return { status: "success", values: { "{{OUTPUT_KEY}}": String(payload.result ?? "") } };
}
